// P0.7 - Voice notes light.
// 30-second voice memo recorded from the lead detail page (saha satışçısı ICP4).
// Transcribed via Whisper / Gemini, attached to the lead, optionally appended to
// WatchlistItem.pipelineNotes for pipeline visibility.
model VoiceNote {
  id          String   @id @default(cuid())
  leadId      String   @map("lead_id")
  workspaceId String   @map("workspace_id")
  audioUrl    String?  @map("audio_url")
  durationSec Int      @default(0) @map("duration_sec")
  transcript  String?  @db.Text
  language    String?
  source      String   @default("web") @map("source")
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([workspaceId])
  @@map("voice_notes")
}

// P1.1 - Direct email send.
// Connected Gmail / Outlook OAuth account used to send openers + mockup links
// from inside the platform. CSV export to Smartlead/Instantly stays as the
// alternative path for users who already live in those senders.
model EmailAccount {
  id                      String        @id @default(cuid())
  workspaceId             String        @map("workspace_id")
  userId                  String        @map("user_id") @db.Uuid
  provider                EmailProvider
  email                   String
  accessToken             String        @map("access_token") @db.Text
  refreshToken            String        @map("refresh_token") @db.Text
  expiresAt               DateTime?     @map("expires_at")
  dailyLimit              Int           @default(500) @map("daily_limit")
  sentToday               Int           @default(0) @map("sent_today")
  resetAt                 DateTime      @default(now()) @map("reset_at")
  // P1.4 reply attribution opt-in. When true, the worker reads inbox replies
  // and updates SalesOpportunity.status accordingly.
  replyAttributionEnabled Boolean       @default(false) @map("reply_attribution_enabled")
  lastInboxSyncAt         DateTime?     @map("last_inbox_sync_at")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([userId])
  @@map("email_accounts")
}

// Stripe webhook idempotency. Stripe retries delivered events; we insert
// the event id on first successful handling and skip replays. No PII; just
// the event id and type for audit.
model StripeEventLog {
  id         String   @id
  type       String
  receivedAt DateTime @default(now()) @map("received_at")

  @@index([receivedAt])
  @@map("stripe_event_log")
}

// P1.2 - AI sales co-pilot chat.
// Workspace-wide chat history. Each message references which leadIds the
// assistant pulled context from, so the user can audit "where did this
// recommendation come from."
model CopilotMessage {
  id          String      @id @default(cuid())
  workspaceId String      @map("workspace_id")
  userId      String      @map("user_id") @db.Uuid
  role        CopilotRole
  content     String      @db.Text
  // [leadId, leadId, ...] - which leads the assistant pulled context from.
  leadIds     Json        @default("[]") @map("lead_ids")
  // Token cost tracking for tier quota enforcement.
  tokensIn    Int         @default(0) @map("tokens_in")
  tokensOut   Int         @default(0) @map("tokens_out")
  createdAt   DateTime    @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("copilot_messages")
}

// AI Workers runtime - one row per agent worker invocation. Phase 1 writes
// rows for Grup B + C workers (Pitch + Deliverable). Grup A workers still
// mutate Lead.crawlStatus / analyzeStatus / reviewAnalysisStatus to avoid a
// breaking migration; they move to AgentRun in Phase 2.
//
// Lifecycle: row created PENDING by API handler, worker picks up, marks
// RUNNING, finishes as SUCCEEDED or FAILED. outputJson holds the worker's
// raw structured output (JSON schema per worker kind). artifactUrl is set
// when the worker produces a shareable public link (e.g. a WebsiteMockup
// slug becomes /m/{slug}). errorMsg captures the failure message for UI.
model AgentRun {
  id                   String          @id @default(cuid())
  workspaceId          String          @map("workspace_id")
  leadId               String?         @map("lead_id")
  userId               String?         @map("user_id") @db.Uuid
  workerKind           AgentWorkerKind @map("worker_kind")
  status               AgentRunStatus  @default(PENDING)
  inputsJson           Json            @default("{}") @map("inputs_json")
  outputJson           Json?           @map("output_json")
  artifactUrl          String?         @map("artifact_url")
  costTokens           Int             @default(0) @map("cost_tokens")
  // USD-denominated external cost (primarily Apify actor runs). Gemini
  // usage continues to flow through costTokens; keeping them separate
  // means the UI can split "AI model spend" from "data enrichment spend".
  costUsdCents         Int             @default(0) @map("cost_usd_cents")
  // DAG coordination. When set, this run was scheduled as part of a
  // PlannerSession; parentRunId points at an upstream run whose output
  // we depended on. Both are nullable so legacy single-shot runs stay
  // working.
  parentRunId          String?         @map("parent_run_id")
  plannerSessionId     String?         @map("planner_session_id")
  // Deterministic hash of (workspaceId, workerKind, leadId, inputs).
  // When two callers try to enqueue the same work concurrently the
  // second one collides on the unique index and must re-use the
  // existing row instead of creating a duplicate. BullMQ job ids
  // also derive from this so retries cannot land twice.
  // The unique index on (workspace_id, idempotency_key) is created
  // as a partial index (WHERE idempotency_key IS NOT NULL) in
  // prisma/migrations/add_agent_run_idempotency_key.sql so legacy
  // rows with NULL keys do not collide. Prisma cannot express the
  // WHERE clause so we run it out of band after `prisma db push`.
  idempotencyKey       String?         @map("idempotency_key")
  // Snapshot of `Lead.subNicheVersion` at enqueue time. When the
  // worker resolves and finds the lead's current version is higher,
  // it exits with status SUCCEEDED + reason "stale-subniche-version"
  // without writing any lead state. Protects against a worker that
  // was queued before a rep override / re-classification overwriting
  // the fresh result. Null for runs unrelated to a lead or for legacy
  // rows pre-dating the version stamp.
  inputSubNicheVersion Int?            @map("input_sub_niche_version")
  errorMsg             String?         @map("error_msg") @db.Text
  startedAt            DateTime?       @map("started_at")
  finishedAt           DateTime?       @map("finished_at")
  createdAt            DateTime        @default(now()) @map("created_at")

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead           Lead?           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  plannerSession PlannerSession? @relation(fields: [plannerSessionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, workerKind, createdAt])
  @@index([leadId, workerKind])
  @@index([plannerSessionId])
  @@map("agent_runs")
}

// Website Mockup Generator output - a fully rendered landing page for a
// single lead. The current `Mockup` table stores markdown website PLANS
// (strategy docs) with a confusing `htmlContent` field name; `WebsiteMockup`
// is the real landing-page artifact. Served at /m/{slug} (unified route
// prefers WebsiteMockup over legacy Mockup for the same slug keyspace).
//
// Storage: sectionsJson holds the Gemini-produced structured data
// (hero / services / testimonial / cta / about); themeJson holds the
// color + mode config; htmlCache caches the server-rendered HTML string
// so /m/{slug} stays instant-load on cold-email click. Regenerate a
// mockup by nulling htmlCache, the public route re-renders on next hit.
model WebsiteMockup {
  id           String    @id @default(cuid())
  slug         String    @unique
  leadId       String    @map("lead_id")
  workspaceId  String    @map("workspace_id")
  sectionsJson Json      @map("sections_json")
  themeJson    Json      @map("theme_json")
  htmlCache    String?   @map("html_cache") @db.Text
  templateId   String    @default("leadac-hero-v1") @map("template_id")
  isPublic     Boolean   @default(true) @map("is_public")
  expiresAt    DateTime? @map("expires_at")
  viewCount    Int       @default(0) @map("view_count")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([workspaceId])
  @@map("website_mockups")
}

// AI Core - semantic memory substrate. Every worker reads/writes here
// through `src/lib/ai-core/memory.ts`. `embedding` is a pgvector
// vector(768) column populated by Gemini gemini-embedding-001 (with
// outputDimensionality=768 — the model also supports 1536/3072 but
// 768 keeps the schema unchanged from the legacy text-embedding-004
// integration). An HNSW index on `embedding vector_cosine_ops` is
// created via a raw SQL
// migration (see prisma/migrations/add_ai_core.sql). `metadata` carries
// kind-specific extras (e.g. social platform, SERP query, reply outcome).
model SemanticMemory {
  id          String                      @id @default(cuid())
  workspaceId String                      @map("workspace_id")
  kind        MemoryKind
  leadId      String?                     @map("lead_id")
  // Free-form reference back to the source domain object. `refType` is
  // a string rather than an enum so new kinds (e.g. pointing at
  // `WebsiteMockup`) don't require a migration. Pair it with `refId`.
  refType     String?                     @map("ref_type")
  refId       String?                     @map("ref_id")
  // Niche pack slug this row was learned from. For hybrid niches
  // (parent + 10 children) we tag with the most specific slug — i.e.
  // the lead's `subNicheSlug` ("fnb-bar-club") if present, else its
  // `nicheSlug` ("fnb"). Reads scope by querying the child slug first
  // and falling back to "any child of parent" (LIKE 'fnb-%') when the
  // child has too few hits. Null for niche-agnostic memory like
  // WORKSPACE_OFFER, WORKSPACE_PERSONA, COPILOT_TURN.
  nicheScope  String?                     @map("niche_scope")
  text        String                      @db.Text
  // Nullable so an upsert can create the row first and enqueue an embed
  // job that populates the vector asynchronously.
  embedding   Unsupported("vector(768)")?
  metadata    Json                        @default("{}")
  createdAt   DateTime                    @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // Composite uniqueness on (workspaceId, refType, refId, nicheScope)
  // so concurrent upserts cannot duplicate the same source object
  // within the same scope, while still permitting the asymmetric
  // dual-write strategy: a positive signal (OPENER_SUCCESS,
  // MOCKUP_SECTION, LEAD_PROFILE) is written twice — once tagged
  // with the child slug ("fnb-bar-club") and once with the parent
  // slug ("fnb") — so a brand-new sub-niche with no hits still gets
  // few-shot fuel from the parent. Negative signals (OPENER_FAILURE)
  // are written child-only so a bar-club failure doesn't poison
  // cafe-bakery retrieval. Postgres treats NULL as distinct, so rows
  // without refType/refId (COPILOT_TURN) are unaffected by this key.
  @@unique([workspaceId, refType, refId, nicheScope])
  @@index([workspaceId, kind])
  @@index([workspaceId, kind, nicheScope])
  @@index([leadId])
  @@map("semantic_memory")
}

// AI Core - planner session. One row per orchestration invocation. The
// `plan` JSON is an array of steps `[{ stepId, workerKind, dependsOn[],
// status, inputs?, optional? }]` populated by `src/lib/ai-core/planner.ts`
// and advanced by `src/lib/ai-core/orchestrator.ts`. Every AgentRun
// spawned from a session carries `plannerSessionId` back here so the
// UI can render the DAG as a single entity.
model PlannerSession {
  id          String         @id @default(cuid())
  workspaceId String         @map("workspace_id")
  userId      String?        @map("user_id") @db.Uuid
  leadId      String?        @map("lead_id")
  goal        String         @db.Text
  plan        Json
  status      PlannerStatus  @default(PLANNING)
  triggeredBy PlannerTrigger @map("triggered_by")
  errorMsg    String?        @map("error_msg") @db.Text
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs      AgentRun[]
  Lead      Lead?      @relation(fields: [leadId], references: [id])

  @@index([workspaceId, status])
  @@index([leadId])
  @@map("planner_sessions")
}

// Editable service package tiers shown in Campaigns → Service Packages and
// seeded during onboarding. Each workspace configures its own packages.
// Features is a Postgres text[] column rendered as a checklist in the UI.
model ServicePackage {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  priceLabel  String   @map("price_label")
  features    String[] @map("features")
  isPopular   Boolean  @default(false) @map("is_popular")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Per-workspace name uniqueness so seed scripts and the
  // packages-form UI can upsert by (workspaceId, name) without
  // worrying about duplicates. The pre-existing API route already
  // creates one package per name conceptually; this just enforces
  // it at the DB level.
  @@unique([workspaceId, name])
  @@index([workspaceId, sortOrder])
  @@map("service_packages")
}

// ============================================================================
// Marketing analytics (founder-level, NOT workspace-scoped)
// ----------------------------------------------------------------------------
// First-party tracking for the public marketing surfaces ((marketing) and
// (public) route groups). These tables are intentionally global because
// visitors are anonymous and have no workspace yet. Access is gated through
// `requireAdminEmail()` in src/lib/admin-auth.ts (mirrors the existing
// HEALTH_ADMIN_EMAILS pattern). The multi-tenant `workspaceId` rule does
// NOT apply here.
//
// PII discipline:
// - Raw IP is never written; only sha256(ip) -> ipHash.
// - Property bag rejects form values, emails, names. Stores selectors,
//   visible CTA text, durations, scroll depths.
// - Geo derives from edge headers (x-vercel-ip-country etc.); no IP lookup.
// ============================================================================

// One row per visitor session. A "session" rolls over after 30 minutes of
// idle time on the client (sessionStorage) or when a new visitorId appears.
// `posthogSessionId` is the bridge to PostHog session replay so the admin
// detail view can deep-link "watch the recording".
model MarketingSession {
  id String @id @default(cuid())

  // Long-lived browser fingerprint stored in localStorage. NOT a user id;
  // a single human can have multiple visitorIds (clearing storage, new
  // device). Index helps with "show me everything this visitor has done".
  visitorId String @map("visitor_id")

  startedAt      DateTime  @default(now()) @map("started_at")
  lastActivityAt DateTime  @updatedAt @map("last_activity_at")
  endedAt        DateTime? @map("ended_at")
  durationMs     Int?      @map("duration_ms")

  // Attribution snapshot taken at session start.
  utmSource   String? @map("utm_source")
  utmMedium   String? @map("utm_medium")
  utmCampaign String? @map("utm_campaign")
  utmContent  String? @map("utm_content")
  utmTerm     String? @map("utm_term")
  referrer    String? @db.Text
  landingPath String  @map("landing_path")
  exitPath    String? @map("exit_path")

  // Device.
  userAgent      String? @map("user_agent") @db.Text
  device         String? // "mobile" | "tablet" | "desktop"
  browser        String?
  os             String?
  viewportWidth  Int?    @map("viewport_width")
  viewportHeight Int?    @map("viewport_height")

  // Geo (edge headers only, no IP lookup).
  ipHash  String? @map("ip_hash")
  country String?
  region  String?
  city    String?

  // Engagement summary (denormalized for fast list queries).
  pageCount    Int     @default(0) @map("page_count")
  maxScrollPct Int     @default(0) @map("max_scroll_pct")
  hasEngaged   Boolean @default(false) @map("has_engaged")
  hasConverted Boolean @default(false) @map("has_converted")

  // PostHog cross-link. Set when the client tracker observes
  // posthog.get_session_id() and the ingest endpoint persists it.
  posthogSessionId String? @map("posthog_session_id")

  pageViews MarketingPageView[]
  events    MarketingEvent[]

  @@index([startedAt(sort: Desc)])
  @@index([visitorId])
  @@index([hasConverted, startedAt])
  @@index([utmSource, utmCampaign])
  @@map("marketing_sessions")
}

// One row per page entry. Multiple rows per session (one per navigation).
// `maxScrollPct` and `scrollMilestones` are updated by subsequent batches
// from the same page; we upsert by (sessionId, path, enteredAt).
model MarketingPageView {
  id        String @id @default(cuid())
  sessionId String @map("session_id")

  path       String
  title      String?
  referrer   String?   @db.Text
  enteredAt  DateTime  @default(now()) @map("entered_at")
  leftAt     DateTime? @map("left_at")
  durationMs Int?      @map("duration_ms")

  maxScrollPct     Int   @default(0) @map("max_scroll_pct")
  // Subset of [25, 50, 75, 100] reached. Stored as int[] so we can
  // build distribution histograms in pure SQL via unnest().
  scrollMilestones Int[] @default([]) @map("scroll_milestones")

  session MarketingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, enteredAt])
  @@index([path, enteredAt])
  @@map("marketing_page_views")
}

// Atomic events. `properties` is a Json bag with shape per `type`:
//   click       -> { selector, text, x, y }
//   cta_click   -> { ctaId, text, location }
//   scroll      -> { pct, path }
//   form_focus  -> { formName, fieldName }
//   form_submit -> { formName, fieldCount, durationMs }
//   error       -> { message, source, lineno, colno }
//   signup      -> { method?: "email" }
//   page_view   -> { title?, referrer? }   (denormalised; primary record on MarketingPageView)
model MarketingEvent {
  id         String   @id @default(cuid())
  sessionId  String   @map("session_id")
  pageViewId String?  @map("page_view_id")
  ts         DateTime @default(now())
  type       String
  path       String
  properties Json?

  session MarketingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, ts])
  @@index([type, ts(sort: Desc)])
  @@map("marketing_events")
}

// ============================================================================
// SDR Reasoning Brain (v2) — Sales Cognition Engine
// ----------------------------------------------------------------------------
// Models the persistent state for a sales-framework-grounded reasoning
// stack: ICP, Trigger Events, MEDDPICC (normalized per-fact for evidence
// grounding), SPIN Discovery, Challenger Commercial Insights, Buying
// Committee, Account Tiering, NBA (Next Best Action) with reasoning
// graph + arbitration log, and closed-loop learning aggregates.
//
// Design choices captured in `.cursor/plans/sdr_brain_v1_*.plan.md` v2:
//   - BuyingReadiness (BANT) is a pure derive — see
//     `src/lib/buying-readiness/derive.ts`. No table; recomputed on read.
//   - MEDDPICC is normalized into `DealQualification` (rollup) +
//     `DealQualificationFact` (per-field, evidence-grounded) so analytics
//     can join on `fieldPath` without parsing nested Json.
//   - `Objection.source = REAL | PREDICTED` keeps customer-evidence
//     objections separate from brief-output predictions.
//   - `LeadNextAction.reasoningGraph` Json holds the inline reasoning
//     graph (≤30 nodes typical). `ReasoningTrace` is the opt-in escape
//     hatch for very-large or cross-decision lineage.
//   - `InsightPerformance` aggregate is bumped by OUTCOME_ATTRIBUTOR
//     and read by COMMERCIAL_INSIGHT_MATCHER for win-rate-aware
//     priority decay (Wilson lower bound at the consumer site).
// ============================================================================

// Sales triggers detected on a lead (e.g. "hiring marketing manager",
// "rating dropped 0.4★ in 90 days"). Persistent because every trigger
// must back a downstream NBA / opener with traceable evidence; the
// `OUTCOME_ATTRIBUTOR` worker also bumps `validatedCount` /
// `falsePositiveCount` based on actual reply outcomes so the system
// learns which trigger types are actionable per niche.
enum LeadTriggerType {
  NEW_LOCATION_OPENING
  CHAIN_EXPANSION
  HIRING_MARKETING
  HIRING_OPS
  HIRING_TECH
  BAD_SERVICE_REVIEWS
  RATING_DROP
  MENU_REDESIGN_SIGNAL
  BOOKING_PROVIDER_CHANGE
  DELIVERY_EXPANSION
  INTERNATIONAL_AUDIENCE_GROWTH
  SEASONAL_TOURISM
  COMPETITOR_PRESSURE
  REBRANDING
  FUNDING_RAISED
  EXEC_CHANGE
  // Phase 8 — review-volume detector (PLAN §4 Phase 8). Forward-
  // compatible additions: old code reading the enum still functions,
  // new values fall through default branches.
  REVIEW_VOLUME_SURGE
  REVIEW_VOLUME_DIP
}

// Possible Next Best Action verbs the SDR_BRAIN can recommend. Kept
// flat (not nested per channel) so the UI can render a single dropdown
// when a rep wants to override the LLM's pick.
enum NextActionKind {
  CALL_NOW
  CALL_AT_WINDOW
  EMAIL_FIRST
  WHATSAPP
  WAIT_FOR_REPLY
  DROP_LEAD
  RE_ENGAGE
  BOOK_DISCOVERY
  ENROLL_IN_CAMPAIGN
  ESCALATE_TO_AE
  // Truth Layer v1 (Wave 0 / T-A Decision Gates) — fired when a lead
  // hits the `no_contact` blocking gate (no phone AND no email). The
  // SDR cannot proceed with EMAIL_FIRST or CALL_FIRST until contact
  // discovery completes. Surfaces a different NextGestureBlock CTA
  // (route to enrichment workflow vs the standard outreach CTA).
  CONTACT_DISCOVERY_FIRST
}

// Truth Layer v1 (Wave 0) — direction of a `ReviewAnalysis.switchSignals`
// entry. v1 stored a flat string array; v2 (T-C) splits on direction so
// `inbound` ("X is way better than us" — reviewer praising the prospect's
// category over a competitor) is not lumped with `outbound` (reviewer
// having left the prospect's brand). Drives trigger-detector's
// COMPETITOR_PRESSURE rule (only `outbound` qualifies) and the
// IntelligenceBriefCard's switch-signal rendering.
enum SwitchDirection {
  inbound
  outbound
  comparison_neutral
}

// Truth Layer v1 (Wave 0 / T-E) — multi-source verification of whether
// a lead actually has a website. `confirmed_present` requires >= 1
// positive source. `confirmed_absent` requires >= 3 negative sources
// (per T-E orchestrator policy in `website-multi-verify.ts`).
// `uncertain` is the fallback. T-D MUST NOT ship "no website" claims
// unless this column is `confirmed_absent`.
enum WebsiteVerificationStatus {
  confirmed_present
  confirmed_absent
  uncertain
}

enum Channel {
  EMAIL
  PHONE
  WHATSAPP
  LINKEDIN
  SMS
}

// Canonical 11-stage deal pipeline. The kanban renders 7 columns
// (PROSPECTING / PREPARATION / APPROACH / DISCOVERY+PRESENTATION /
// OBJECTION_HANDLING+NEGOTIATION / CLOSING / WON_LOST_FOLLOWUP modal).
// Stored on WatchlistItem so a single deal can transition through the
// stages with a clear log.
enum DealStage {
  PROSPECTING
  PREPARATION
  APPROACH
  DISCOVERY
  PRESENTATION
  OBJECTION_HANDLING
  NEGOTIATION
  CLOSING
  WON
  LOST
  FOLLOWUP
}

// Account Tiering — TIER_1 = strategic / 24h SLA, TIER_4 = experimental.
// Drives Today's Queue ordering and the LeadNextAction confidence floor.
enum AccountTier {
  TIER_1
  TIER_2
  TIER_3
  TIER_4
}

// Source of an Objection row. REAL = extracted from a customer reply /
// voice note / call log. PREDICTED = brief output snapshot generated by
// SDR_BRAIN before any customer contact. The two are stored side-by-
// side so a rep can see "we predicted PRICE objection; rep got TRUST
// objection" — and OUTCOME_ATTRIBUTOR can compute the prediction
// accuracy per category over time.
enum ObjectionSource {
  REAL
  PREDICTED
}

// SPIN selling kind for a DiscoveryItem. SITUATION = current state
// fact; PROBLEM = pain identified; IMPLICATION = downstream effect
// (revenue / NPS / churn impact); NEED_PAYOFF = customer-articulated
// payoff if solved. The SPIN_EXTRACTOR worker classifies every
// transcribed sentence in a voice note into one of these; the SDR
// dashboard renders them as 4 columns so the rep can see "we have
// 5 SITUATIONs but no NEED_PAYOFF — this lead is not yet qualified".
enum SpinKind {
  SITUATION
  PROBLEM
  IMPLICATION
  NEED_PAYOFF
}

// Workspace-level Ideal Customer Profile. One row per workspace;
// edited from Settings → ICP. Read by ICP_SCORER (deterministic
// weighted-feature scorer) on every lead_created chain run, then
// persisted as `Lead.icpFitScore` for fast list ordering.
//
// Weights are a free-form Json bag because the schema needs to hold
// niche-specific keys (e.g. `industryWeights = { "fnb-fine-dining":
// 1.5, "fnb-bar-club": 1.0 }`). The scorer validates the shape at
// read time.
model IdealCustomerProfile {
  id                     String   @id @default(cuid())
  workspaceId            String   @unique @map("workspace_id")
  name                   String
  industryWeights        Json     @default("{}") @map("industry_weights")
  subNicheWeights        Json     @default("{}") @map("sub_niche_weights")
  priceLevelMin          Int?     @map("price_level_min")
  priceLevelMax          Int?     @map("price_level_max")
  minReviewCount         Int?     @map("min_review_count")
  minRating              Float?   @map("min_rating")
  digitalMaturityFloor   Int?     @map("digital_maturity_floor")
  highValueSignals       String[] @default([]) @map("high_value_signals")
  negativeSignals        String[] @default([]) @map("negative_signals")
  locationFit            Json     @default("{}") @map("location_fit")
  meddpiccRequiredFields String[] @default([]) @map("meddpicc_required_fields")
  // Human-readable ICP definition the user reads and edits during onboarding.
  // The structured weights above stay the machine-facing inputs for
  // ICP_SCORER; `description` is the primary editing surface for the user.
  description            String?  @db.Text
  // Provenance of the AI-drafted ICP: source URLs, evidence snippets, and a
  // confidence score. Empty object when the profile was authored manually.
  sourceJson             Json     @default("{}") @map("source_json")
  // Bumps every time the row is edited; each Lead.icpVersion stamp
  // compares against this so a stale ICP-fit score doesn't mislead
  // the rep after a policy change.
  version                Int      @default(1)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("ideal_customer_profiles")
}

// Calibration-first onboarding draft store. The WORKSPACE_CONTEXT_EXTRACTOR
// worker crawls the company domain + pricing page and writes editable ICP /
// package drafts here. AI predictions live ONLY in this table until the user
// confirms them — confirmation is what upserts the real IdealCustomerProfile
// / ServicePackage rows. Survives page refresh while the crawl runs.
//
// status values (string, not enum, to keep onboarding states flexible):
//   PENDING   — row created, worker not started yet
//   RUNNING   — calibration worker in flight
//   READY     — drafts produced, awaiting user review/confirm
//   FAILED    — crawl/extract failed; UI shows manual-entry fallback
model WorkspaceOnboardingDraft {
  id                 String   @id @default(cuid())
  workspaceId        String   @unique @map("workspace_id")
  companyContextJson Json     @default("{}") @map("company_context_json")
  icpDraftJson       Json     @default("{}") @map("icp_draft_json")
  packagesDraftJson  Json     @default("[]") @map("packages_draft_json")
  status             String   @default("PENDING")
  error              String?  @db.Text
  lastRunId          String?  @map("last_run_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_onboarding_drafts")
}

// Source-grounded sales trigger detected on a lead. Persistent so the
// reasoning graph can cite "we recommended CALL_NOW on May 12 because
// of LeadTrigger#abc (HIRING_MARKETING) detected on May 10". Decays
// after a niche-specific window (`decayedAt` set by a nightly cron) so
// stale triggers don't pollute future briefs.
//
// `confidence` is a 0..1 Bayesian-ish posterior; OUTCOME_ATTRIBUTOR
// nudges it ±0.05 based on whether the cited trigger preceded a
// REPLY_POSITIVE or a REPLY_NEGATIVE. `validatedCount` and
// `falsePositiveCount` keep the raw counters around for analytics.
model LeadTrigger {
  id                 String          @id @default(cuid())
  workspaceId        String          @map("workspace_id")
  leadId             String          @map("lead_id")
  type               LeadTriggerType
  severity           Int
  confidence         Float
  detectedAt         DateTime        @default(now()) @map("detected_at")
  decayedAt          DateTime?       @map("decayed_at")
  evidence           Json
  impactPrediction   String?         @map("impact_prediction")
  urgencyWindowDays  Int?            @map("urgency_window_days")
  validatedCount     Int             @default(0) @map("validated_count")
  falsePositiveCount Int             @default(0) @map("false_positive_count")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, leadId, type, detectedAt])
  @@index([workspaceId, leadId, decayedAt])
  @@index([workspaceId, type, detectedAt])
  @@map("lead_triggers")
}

// Challenger-style commercial insight. Workspace-scoped (or system seed
// when `workspaceId` is null). The COMMERCIAL_INSIGHT_MATCHER worker
// joins these to active LeadTriggers + ICP to pick the best reframe
// for the next opener; the priority surface is computed at read time
// as `basePriority * winRateMultiplier` from InsightPerformance.
model CommercialInsight {
  id                    String            @id @default(cuid())
  workspaceId           String?           @map("workspace_id")
  nicheSlug             String?           @map("niche_slug")
  industryMyth          String            @map("industry_myth") @db.Text
  reframe               String            @db.Text
  economicImpact        String?           @map("economic_impact") @db.Text
  contrarianObservation String?           @map("contrarian_observation") @db.Text
  applicableTriggers    LeadTriggerType[] @default([]) @map("applicable_triggers")
  applicableSubNiches   String[]          @default([]) @map("applicable_sub_niches")
  evidenceUrl           String?           @map("evidence_url")
  basePriority          Int               @default(50) @map("base_priority")
  createdAt             DateTime          @default(now()) @map("created_at")

  workspace    Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  applications InsightApplication[]
  performance  InsightPerformance[]

  @@index([workspaceId, nicheSlug])
  @@map("commercial_insights")
}

// One row per insight surfaced in a real artifact (opener, NBA, brief).
// Outcome is filled in by OUTCOME_ATTRIBUTOR on terminal events, then
// rolled up into `InsightPerformance` for win-rate ranking.
model InsightApplication {
  id           String    @id @default(cuid())
  workspaceId  String    @map("workspace_id")
  leadId       String    @map("lead_id")
  insightId    String    @map("insight_id")
  surface      String // "OPENER" | "WHY_NOW" | "NBA"
  framework    String? // "AIDA" | "PAS" | "CHALLENGER" | null
  outcome      String? // "REPLY_POSITIVE" | "REPLY_NEGATIVE" | "IGNORED" | "MEETING_BOOKED" | "WON"
  appliedAt    DateTime  @default(now()) @map("applied_at")
  outcomeAt    DateTime? @map("outcome_at")
  attributedBy String?   @map("attributed_by")

  insight CommercialInsight @relation(fields: [insightId], references: [id], onDelete: Cascade)
  lead    Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([workspaceId, leadId])
  @@index([workspaceId, insightId, outcome])
  @@map("insight_applications")
}

// Versioned Next Best Action. The SDR_BRAIN flow writes a
// `isPreliminary = true` row at the end of T1 (~3-5s after lead_created)
// from the BANT_INFERRER deterministic output so the UI can render an
// NBA card immediately. T3 SDR_BRAIN then upserts the final
// `isPreliminary = false` row and stamps `supersededAt` on the
// preliminary one. Older versions are kept for the reasoning trail.
//
// `reasoningGraph` Json shape (typed in
// `src/lib/sdr-brain/reasoning-graph.ts`):
//   { nodes: ReasoningNode[], edges: ReasoningEdge[],
//     contradictions: ContradictionRecord[], modelVersion, generatedAt }
//
// `arbitrationRecords` Json is the de-duped contradiction log produced
// by the deterministic pre-pass + Gemini arbitration, surfaced in the
// "Why?" expandable card on the lead detail page so a rep can see "we
// flagged BANT timing 80 vs WHY_NOW urgency 25 and resolved by
// preferring trigger-based timing".
model LeadNextAction {
  id                   String         @id @default(cuid())
  workspaceId          String         @map("workspace_id")
  leadId               String         @map("lead_id")
  version              Int
  isPreliminary        Boolean        @default(false) @map("is_preliminary")
  actionKind           NextActionKind @map("action_kind")
  timingWindowStart    DateTime?      @map("timing_window_start")
  timingWindowEnd      DateTime?      @map("timing_window_end")
  channel              Channel?
  primaryAngleId       String?        @map("primary_angle_id")
  triggerIds           String[]       @default([]) @map("trigger_ids")
  openingHook          String?        @map("opening_hook") @db.Text
  whatNotToPitch       String[]       @default([]) @map("what_not_to_pitch")
  qualificationGap     String[]       @default([]) @map("qualification_gap")
  predictedObjections  String[]       @default([]) @map("predicted_objections")
  recommendedFramework String?        @map("recommended_framework")
  confidence           Int
  reasoning            String         @db.Text
  reasoningGraph       Json?          @map("reasoning_graph")
  arbitrationRecords   Json           @default("[]") @map("arbitration_records")
  supersededAt         DateTime?      @map("superseded_at")
  outcome              String?
  outcomeAt            DateTime?      @map("outcome_at")
  createdAt            DateTime       @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([workspaceId, leadId, supersededAt])
  @@index([workspaceId, actionKind, timingWindowStart])
  @@map("lead_next_actions")
}

// MEDDPICC rollup per WatchlistItem. Aggregated counters denormalized
// from `DealQualificationFact` so a kanban tile can show "MEDDPICC 70%"
// without a sub-query per card.
model DealQualification {
  watchlistItemId            String    @id @map("watchlist_item_id")
  workspaceId                String    @map("workspace_id")
  fillCompletePct            Int       @default(0) @map("fill_complete_pct")
  riskScore                  Int       @default(0) @map("risk_score")
  championStakeholderId      String?   @map("champion_stakeholder_id")
  championStrength           Int?      @map("champion_strength")
  economicBuyerStakeholderId String?   @map("economic_buyer_stakeholder_id")
  economicBuyerConfidence    Float?    @map("economic_buyer_confidence")
  urgencyLevel               Int?      @map("urgency_level")
  lastExtractedAt            DateTime? @map("last_extracted_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  watchlistItem WatchlistItem           @relation(fields: [watchlistItemId], references: [id], onDelete: Cascade)
  facts         DealQualificationFact[]

  @@index([workspaceId, fillCompletePct])
  @@index([workspaceId, riskScore])
  @@map("deal_qualifications")
}

// Per-field MEDDPICC fact, evidence-grounded. Each `fieldPath` is a
// dot-separated address into the Json shape (e.g. "metric.avgOrderValue",
// "decisionCriteria.<nanoid>.criterion", "competitor.<nanoid>.name",
// "decisionProcess.<step>.status", "paperProcess.contractApproval").
//
// `supersededAt` is set when a newer fact for the same fieldPath
// arrives — analytics queries always filter on `supersededAt IS NULL`
// to get the current state.
model DealQualificationFact {
  id              String    @id @default(cuid())
  workspaceId     String    @map("workspace_id")
  watchlistItemId String    @map("watchlist_item_id")
  fieldPath       String    @map("field_path")
  value           Json
  confidence      Float
  evidenceSpan    Json?     @map("evidence_span")
  sourceQuote     String?   @map("source_quote") @db.Text
  sourceRefType   String?   @map("source_ref_type")
  sourceRefId     String?   @map("source_ref_id")
  extractedAt     DateTime  @default(now()) @map("extracted_at")
  extractedBy     String    @map("extracted_by")
  supersededAt    DateTime? @map("superseded_at")

  qualification DealQualification @relation(fields: [watchlistItemId], references: [watchlistItemId], onDelete: Cascade)

  @@index([workspaceId, watchlistItemId, fieldPath])
  @@index([workspaceId, watchlistItemId, supersededAt])
  @@map("deal_qualification_facts")
}

// SPIN Discovery session — usually a transcribed voice note or a
// rep-typed call note. Items are SPIN-classified one row per sentence.
model DiscoverySession {
  id              String   @id @default(cuid())
  workspaceId     String   @map("workspace_id")
  leadId          String   @map("lead_id")
  watchlistItemId String?  @map("watchlist_item_id")
  source          String // "VOICE_NOTE" | "EMAIL_THREAD" | "MANUAL"
  sourceRefId     String?  @map("source_ref_id")
  notes           String?  @db.Text
  conductedBy     String?  @map("conducted_by") @db.Uuid
  conductedAt     DateTime @default(now()) @map("conducted_at")
  createdAt       DateTime @default(now()) @map("created_at")

  lead  Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  items DiscoveryItem[]

  @@index([workspaceId, leadId])
  @@map("discovery_sessions")
}

model DiscoveryItem {
  id           String   @id @default(cuid())
  sessionId    String   @map("session_id")
  spinKind     SpinKind @map("spin_kind")
  text         String   @db.Text
  evidence     String?  @db.Text
  evidenceSpan Json?    @map("evidence_span")
  confidence   Float
  createdAt    DateTime @default(now()) @map("created_at")

  session DiscoverySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, spinKind])
  @@map("discovery_items")
}

// Buying Committee mapping. A Stakeholder is a person attached to a
// Lead (and optionally an Account when multi-location). Filled by
// STAKEHOLDER_DISCOVERER (company-level Apify + crawl + manual entry)
// and refined by reps. `championLikelihood` and `isEconomicBuyer` are
// the two MEDDPICC anchors that gate AE escalation.
model Stakeholder {
  id                 String    @id @default(cuid())
  workspaceId        String    @map("workspace_id")
  leadId             String?   @map("lead_id")
  accountId          String?   @map("account_id")
  name               String?
  role               String?
  email              String?
  phone              String?
  linkedinUrl        String?   @map("linkedin_url")
  influence          Int?
  sentiment          String?
  championLikelihood Int?      @map("champion_likelihood")
  isEconomicBuyer    Boolean   @default(false) @map("is_economic_buyer")
  isBlocker          Boolean   @default(false) @map("is_blocker")
  contacted          Boolean   @default(false)
  lastContactedAt    DateTime? @map("last_contacted_at")
  source             String
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([workspaceId, leadId])
  @@index([workspaceId, accountId])
  @@index([workspaceId, isEconomicBuyer])
  @@map("stakeholders")
}

// Sales objection — REAL when extracted from customer evidence,
// PREDICTED when produced by SDR_BRAIN (snapshot of the brief output).
// Predicted objections cross-link back to the LeadNextAction that
// produced them so OUTCOME_ATTRIBUTOR can compute prediction accuracy.
model Objection {
  id                    String          @id @default(cuid())
  workspaceId           String          @map("workspace_id")
  leadId                String          @map("lead_id")
  text                  String          @db.Text
  category              String?
  source                ObjectionSource @default(PREDICTED)
  rebuttalUsed          String?         @map("rebuttal_used") @db.Text
  resolvedAt            DateTime?       @map("resolved_at")
  evidenceRefType       String?         @map("evidence_ref_type")
  evidenceRefId         String?         @map("evidence_ref_id")
  predictedFromActionId String?         @map("predicted_from_action_id")
  createdAt             DateTime        @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([workspaceId, leadId, source])
  @@index([workspaceId, leadId, resolvedAt])
  @@index([workspaceId, category])
  @@map("objections")
}

// Per-step orchestrator telemetry. Written from the orchestrator after
// each AgentRun completes so the admin dashboard can show "p95
// SDR_BRAIN duration last 7 days = 24s, slaBreach=2.1%". Distinct from
// AgentRun (which carries the result) — this row carries the
// observability metadata even when the run is FAILED or SUCCEEDED_NO_MEMORY.
model ChainTelemetry {
  id               String   @id @default(cuid())
  workspaceId      String   @map("workspace_id")
  plannerSessionId String   @map("planner_session_id")
  agentRunId       String?  @map("agent_run_id")
  workerKind       String?  @map("worker_kind")
  stepId           String?  @map("step_id")
  durationMs       Int?     @map("duration_ms")
  costTokens       Int?     @map("cost_tokens")
  costUsdCents     Int?     @map("cost_usd_cents")
  memoryHits       Int?     @map("memory_hits")
  slaBreach        Boolean  @default(false) @map("sla_breach")
  errorClass       String?  @map("error_class")
  recordedAt       DateTime @default(now()) @map("recorded_at")

  @@index([workspaceId, plannerSessionId])
  @@index([workspaceId, workerKind, recordedAt])
  @@index([workspaceId, slaBreach, recordedAt])
  @@map("chain_telemetry")
}

// Insight performance aggregate. Bumped by OUTCOME_ATTRIBUTOR. Read by
// COMMERCIAL_INSIGHT_MATCHER's deterministic pre-rank to compute Wilson
// lower bound at the consumer site (so brand-new insights with 0/0
// don't get ranked above proven 47/200 ones).
//
// The unique key is intentionally wide: the same insight × niche ×
// trigger × framework × tier might exist in many workspaces; we count
// per-workspace.
model InsightPerformance {
  id            String           @id @default(cuid())
  workspaceId   String           @map("workspace_id")
  insightId     String           @map("insight_id")
  nicheSlug     String?          @map("niche_slug")
  triggerType   LeadTriggerType?
  framework     String?
  segmentTier   AccountTier?     @map("segment_tier")
  applied       Int              @default(0)
  replyPositive Int              @default(0) @map("reply_positive")
  replyNegative Int              @default(0) @map("reply_negative")
  ignored       Int              @default(0)
  meetingBooked Int              @default(0) @map("meeting_booked")
  won           Int              @default(0)
  lastUpdatedAt DateTime         @updatedAt @map("last_updated_at")

  insight   CommercialInsight @relation(fields: [insightId], references: [id], onDelete: Cascade)
  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Postgres treats NULL as distinct in a unique constraint, so two
  // rows with the same workspaceId+insightId but different (null vs
  // not null) nicheSlug are allowed — that's intentional, the
  // analytics consumer sums across the bucket dimensions it cares about.
  @@unique([workspaceId, insightId, nicheSlug, triggerType, framework, segmentTier])
  @@index([workspaceId, insightId])
  @@index([workspaceId, nicheSlug, triggerType])
  @@map("insight_performance")
}

// Opt-in extended reasoning lineage. Used when a LeadNextAction's
// inline `reasoningGraph` exceeds ~30 nodes or when a decision spans
// multiple LeadNextAction versions and the rep wants the full trail.
// Phase 1 keeps every graph inline; Phase 2 will write here when a
// `--full-trace` debug flag is set on the SDR_BRAIN run.
model ReasoningTrace {
  id              String   @id @default(cuid())
  workspaceId     String   @map("workspace_id")
  leadId          String?  @map("lead_id")
  decisionRefType String   @map("decision_ref_type")
  decisionRefId   String   @map("decision_ref_id")
  provider        String
  modelVersion    String   @map("model_version")
  graph           Json
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([workspaceId, leadId])
  @@index([workspaceId, decisionRefType, decisionRefId])
  @@map("reasoning_traces")
}
