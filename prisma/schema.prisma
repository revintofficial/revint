generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CrawlStatus {
  PENDING
  CRAWLING
  CRAWLED
  FAILED
  NO_WEBSITE
}

enum AnalyzeStatus {
  PENDING
  ANALYZING
  ANALYZED
  FAILED
}

enum ReviewAnalysisStatus {
  PENDING
  ANALYZING
  ANALYZED
  FAILED
  NO_REVIEWS
}

enum SuggestedOffer {
  STARTER
  GROWTH
  SALES
}

enum OutreachStatus {
  NEW
  CONTACTED
  INTERESTED
  MEETING
  WON
  LOST
}

enum MeetingResult {
  POSITIVE
  NEGATIVE
  IN_PROGRESS
}

enum PipelineStage {
  NEW
  REACHED_OUT
  IN_TALKS
  WON
  LOST
}

enum Plan {
  FREE
  PRO
  PRO_TEAM
  AGENCY
}

// Lead onboarding pipeline preset — drives the per-workspace
// `lead_created` chain. LITE keeps FREE-tier workspaces under their
// Gemini budget; BALANCED is the default for new workspaces and adds
// social scrape + on-create dossier; AGGRESSIVE turns on Apify gmaps
// deep + auto mockup + auto opener (PRO+ only). CUSTOM means the
// owner has hand-edited the steps array; the resolver no longer
// regenerates it from the preset.
enum PipelinePreset {
  LITE
  BALANCED
  AGGRESSIVE
  CUSTOM
}

enum WorkspaceNiche {
  WEB_AGENCY      // default — generic web/marketing agency
  RESTAURANT_TECH // QR menu / digital ordering (FineDine, MenuTiger, etc.)
  DENTAL          // reserved
  REAL_ESTATE     // reserved
}

// Source of a lead's `subNicheSlug` value. AUTO means the
// FNB_SUBVERTICAL_CLASSIFIER worker tagged it; MANUAL means a sales rep
// overrode it from the lead detail page. The classifier worker MUST skip
// leads whose source is MANUAL so reps' overrides are never reverted.
enum SubNicheSource {
  AUTO
  MANUAL
}

// Pipeline-level state of a Lead. OK means the planner is free to run
// the lead_created chain. BLOCKED_NEEDS_PACKAGES means the workspace
// has not configured any ServicePackage rows yet, so the SCORER would
// have nothing to recommend — the lead is parked and the UI surfaces a
// "process pending leads" CTA on the Service Packages settings page
// once the rep adds their first tier. Distinct from analyzeStatus /
// crawlStatus / reviewAnalysisStatus which describe individual worker
// outcomes; this one gates the entire lead_created chain at emit-time.
enum LeadPipelineStatus {
  OK
  BLOCKED_NEEDS_PACKAGES
}

// SDR call disposition logged after a phone touch. Set by the rep
// from the Lead Detail "Log call outcome" modal. Drives the SDR
// throughput dashboard (calls today, voicemails, no-answer ratio)
// and feeds the Today's Queue ordering — ANSWERED_NOT_INTERESTED
// and OPTED_OUT pull a lead out of the queue, VOICEMAIL/NO_ANSWER
// schedule a re-attempt.
enum CallDisposition {
  ANSWERED_INTERESTED
  ANSWERED_NOT_INTERESTED
  VOICEMAIL
  NO_ANSWER
  WRONG_NUMBER
  BOOKED_MEETING
  OPTED_OUT
}

// Lead activity timeline kind. Every touch (call, email send/reply,
// WhatsApp, manual note, status change, meeting booking, sequence
// step firing, disposition logging) writes a LeadActivity row so the
// detail page can render a real timeline instead of showing only
// `updatedAt`. Drives the SDR throughput dashboard and the per-lead
// "next action" recommendation.
enum LeadActivityKind {
  CALL_LOGGED
  EMAIL_SENT
  EMAIL_REPLIED
  WHATSAPP_SENT
  NOTE
  STATUS_CHANGED
  MEETING_BOOKED
  DISPOSITION_LOGGED
  SEQUENCE_STEP_FIRED
  SNOOZED
  ASSIGNED
  CONSENT_RECORDED
}

enum EmailProvider {
  GMAIL
  OUTLOOK
}

enum CopilotRole {
  USER
  ASSISTANT
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

// AI Workers catalog. Every lead-activated AI deliverable produced by the
// platform is one of these kinds. Keep this enum exhaustive: if a new worker
// ships, add it here first, then wire a registry entry in
// src/lib/agent-workers/registry.ts.
//
// Group A (Intelligence): auto-run on lead ingest; Grup B (Pitch):
// agency-facing artifacts sent to prospects; Grup C (Deliverable):
// ready-to-install config packs for the prospect's own stack (Synthflow,
// Retell, GHL, etc.); Grup D (Ops): platform-level ongoing work;
// Grup E (Enrichment): Apify-backed external data sources that feed
// SemanticMemory for every other worker to retrieve.
enum AgentWorkerKind {
  // Grup A - Intelligence
  WEBSITE_AUDITOR
  REVIEW_ANALYST
  SALES_OPPORTUNITY_SCORER
  SOCIAL_SCRAPER
  EMAIL_VERIFIER
  // GOOGLE_PLACES_REVIEWS pre-loads up to 5 reviews from Places API on
  // lead_created so REVIEW_ANALYST has corpus to chew on. FREE-safe
  // (no Gemini, no Apify, just one Places API call).
  GOOGLE_PLACES_REVIEWS
  // SUBVERTICAL_CLASSIFIER tags hybrid-niche leads with a child sub-niche
  // slug. The worker dispatches on the workspace niche to pick the
  // parent pack (RESTAURANT_TECH → "fnb", DENTAL → "dental", ...) and
  // scores the lead against that parent's children using a rule-based
  // first pass (Google Places types + name + website signals + price
  // level) and a Gemini fallback when rules are inconclusive. Only
  // runs when the lead is not already MANUAL-sourced. Drives audit /
  // opener / mockup branching downstream.
  SUBVERTICAL_CLASSIFIER
  // Grup B - Pitch
  WEBSITE_PLAN_GENERATOR
  WEBSITE_MOCKUP_GENERATOR
  OPENER_WRITER
  VIDEO_SCRIPT_WRITER
  VOICE_NOTE_TRANSCRIBER
  // LEAD_DOSSIER_GENERATOR encapsulates the previously-uncached
  // /api/leads/[id]/explain logic. Output is cached on AgentRun so
  // the dossier button serves instantly until reviews / Apify runs
  // invalidate it.
  LEAD_DOSSIER_GENERATOR
  // LEAD_INTELLIGENCE_BRIEF (Phase 0/B5) — the canonical "single
  // source of truth" worker. Runs at the END of the lead_created
  // chain, after every enrichment + scoring + classification +
  // mockup + opener has either succeeded or been SKIPPED. Reads
  // every Lead-scoped artifact (audit, reviewAnalysis, salesOpp,
  // social profiles, deep crawl memory, sub-niche, voice notes,
  // dossier, mockup) and writes BOTH a structured JSON brief
  // (Sales Talking Points, Best Time To Call hint, Next Action,
  // Sales Confidence 0-100) AND bumps Lead.intelligenceVersion +
  // Lead.salesConfidence. Replaces the dossier button as the
  // primary "AI sales brief" the rep sees. Dossier remains as a
  // long-form fallback for users who still want the markdown narrative.
  LEAD_INTELLIGENCE_BRIEF
  // Grup C - Deliverable (prospect install packs)
  AI_RECEPTIONIST_BUILDER
  REVIEW_REPLY_AGENT
  LEAD_RESPONSE_AGENT
  BOOKING_WIDGET_BUILDER
  GBP_AUTOPOST_AGENT
  // Grup D - Ops
  COPILOT_CHAT
  INBOX_REPLY_ATTRIBUTOR
  OUTREACH_SENDER
  CONTAINMENT_RATE_TRACKER
  // Grup E - Enrichment (Apify-backed external data sources)
  APIFY_GMAPS_DEEP
  APIFY_WEB_CRAWL_DEEP
  APIFY_INSTAGRAM_DEEP
  APIFY_FACEBOOK_DEEP
  APIFY_TIKTOK_DEEP
  APIFY_SERP_RANK
  APIFY_COMPETITOR_ADS
  APIFY_LINKEDIN_COMPANY
  APIFY_REDDIT_MENTIONS
}

// AI Core - semantic memory kind taxonomy. Every SemanticMemory row
// carries one of these labels so retrieval queries can filter down to
// the right substrate (lead profile embeddings vs opener successes vs
// Apify-sourced social posts).
enum MemoryKind {
  // Foundational kinds written by native workers
  LEAD_PROFILE
  REVIEW_CHUNK
  VOICE_NOTE
  OPENER_SUCCESS
  OPENER_FAILURE
  MOCKUP_SECTION
  WORKSPACE_OFFER
  WORKSPACE_PERSONA
  PROSPECT_KB_CHUNK
  COPILOT_TURN
  // Apify enrichment kinds
  SOCIAL_POST
  SERP_SNAPSHOT
  COMPETITOR_AD
  HIRING_SIGNAL
  REDDIT_MENTION
}

enum PlannerStatus {
  PLANNING
  EXECUTING
  COMPLETED
  FAILED
  CANCELLED
}

enum PlannerTrigger {
  EVENT
  USER_COPILOT
  USER_BUTTON
  USER_BULK
  USER_DEEP_RESEARCH
}

enum AgentRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  // Beta finding §7: the worker's primary artifact succeeded but the
  // post-run memory write or the memoryReads pre-fetch hit an
  // EmbeddingError (Gemini 429 / 403). The row is logically successful
  // — downstream chains may proceed, the rep sees the deliverable —
  // but a backfill embed job needs to run before this row participates
  // in semantic retrieval. Distinct from SUCCEEDED so the UI can show
  // an "AI memory degraded" badge and operators can grep for the
  // bucket without scanning errorMsg.
  SUCCEEDED_NO_MEMORY
  FAILED
  CANCELLED
}

// Mirrors Supabase auth.users.id (uuid). A trigger keeps these in sync.
model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  fullName  String?  @map("full_name")
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]
  assignedLeads   Lead[]            @relation("LeadAssignee")
  leadSegments    LeadSegment[]     @relation("LeadSegmentCreator")

  @@map("users")
}

model Workspace {
  id                     String    @id @default(cuid())
  name                   String
  slug                   String    @unique
  ownerId                String    @map("owner_id") @db.Uuid
  plan                   Plan      @default(FREE)
  stripeCustomerId       String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId   String?   @unique @map("stripe_subscription_id")
  currentPeriodEnd       DateTime? @map("current_period_end")
  leadsCreatedThisCycle  Int       @default(0) @map("leads_this_cycle")
  aiCreditsUsedThisCycle Int       @default(0) @map("ai_credits_this_cycle")
  cycleResetAt           DateTime  @default(now()) @map("cycle_reset_at")

  // White-label branding (Agency+ tier). Mockup pages, exports, and partner
  // collateral pick this up to render workspace-specific styling.
  branding Json?

  // Public lead profile gate. When true, indexable /[country]/[city]/[niche]/[business]
  // pages are rendered for this workspace's leads. Workspaces opt in.
  publicProfilesEnabled Boolean @default(false) @map("public_profiles_enabled")

  // P0.2 "My offer" workspace context. These fields feed both the SalesOpportunity
  // prompt (offer ↔ pain matching) and the website-plan prompt (mockup CTA + hero).
  // Without them every email and mockup is generic; with them they are tailored
  // to what THIS workspace actually sells. See plan.md §4 P0.2.
  offerName        String? @map("offer_name")
  valueProposition String? @map("value_proposition") @db.Text
  socialProof      String? @map("social_proof") @db.Text
  offerHook        String? @map("offer_hook") @db.Text
  objective        String? @map("objective")
  tone             String? @map("tone")
  length           String? @map("length")
  language         String  @default("en") @map("language")
  senderName       String? @map("sender_name")
  conversionLink   String? @map("conversion_link")
  niche            WorkspaceNiche @default(WEB_AGENCY) @map("niche")

  // M12 - per-workspace HMAC secret for the telephony webhook.
  // Replaces the single shared TELEPHONY_WEBHOOK_TOKEN env var so a
  // leaked / reused token can only address one tenant. Lazily
  // populated on first webhook setup; null means the workspace has
  // not opted into telephony attribution. The unique constraint
  // lets the webhook route resolve the workspace from the token
  // without trusting a `workspaceId` query param.
  telephonyWebhookSecret String? @unique @map("telephony_webhook_secret")

  // Optional sub-niche focus list. When the workspace's parent vertical (e.g.
  // RESTAURANT_TECH → "fnb") has child packs, the rep can narrow which ones
  // their team actually pitches (e.g. only fine-dining + bar + hotel) so the
  // Discovery defaults, classifier prior, and quota planner know which slugs
  // are in scope. Empty/null means "all children of the parent vertical".
  // Stored as slugs (e.g. ["fnb-fine-dining","fnb-bar-club"]) — string array,
  // not enum, because slugs are URL-shaped while the enum is DB-shaped.
  targetSubNiches String[] @default([]) @map("target_sub_niches")

  // Workspace country (ISO-3166-1 alpha-2, e.g. "GB", "US"). Used to scope
  // Discovery queries globally instead of defaulting to London boroughs.
  country String? @map("country")

  // Set when the owner completes the onboarding wizard. Null means the owner
  // is still being redirected into the flow on each dashboard visit.
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner           User                   @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members         WorkspaceMember[]
  leads           Lead[]
  todos           TeamTodo[]
  emailAccounts   EmailAccount[]
  copilotMessages CopilotMessage[]
  agentRuns       AgentRun[]
  websiteMockups  WebsiteMockup[]
  semanticMemory  SemanticMemory[]
  plannerSessions PlannerSession[]
  servicePackages ServicePackage[]
  leadPipeline    WorkspaceLeadPipeline?
  leadSegments    LeadSegment[]
  sequences       Sequence[]
  accounts        Account[]

  @@map("workspaces")
}

// AI Core - workspace-scoped lead onboarding pipeline configuration.
// Stores the (preset, steps) tuple that drives the `lead_created`
// chain for this workspace. When `preset != CUSTOM`, the resolver
// regenerates `steps` from the preset on every read (so plan upgrades
// unlock new workers automatically); CUSTOM is treated as-is.
//
// `steps` JSON shape mirrors `ChainStep[]` from
// src/lib/ai-core/chains.ts. The resolver validates it before
// scheduling so a malformed UI write cannot crash the orchestrator.
model WorkspaceLeadPipeline {
  id          String         @id @default(cuid())
  workspaceId String         @unique @map("workspace_id")
  preset      PipelinePreset @default(BALANCED)
  steps       Json           @default("[]")
  enabled     Boolean        @default(true)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_lead_pipelines")
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id") @db.Uuid
  role        Role     @default(MEMBER)
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Lead {
  id                   String               @id @default(cuid())
  workspaceId          String               @map("workspace_id")
  placeId              String               @map("place_id")
  businessName         String               @map("business_name")
  formattedAddress     String               @map("formatted_address")
  borough              String?
  phone                String?
  websiteUrl           String?              @map("website_url")
  hasWebsite           Boolean              @default(false) @map("has_website")
  googleMapsUri        String?              @map("google_maps_uri")
  rating               Float?
  reviewCount          Int?                 @map("review_count")
  businessStatus       String?              @map("business_status")
  primaryType          String?              @map("primary_type")
  // Google Places `priceLevel` (0..4 ladder, 0=free, 4=very expensive).
  // Captured from the v1 enum at discovery time and used by:
  //   - the rule-based sub-niche classifier (priceLevelRange match,
  //     +0.15 weight per `src/lib/niches/index.ts`),
  //   - the fine-dining auto-assign rule (rating ≥ 4.5 + reviews ≥ 200
  //     + priceLevel ≥ 3 → fnb-fine-dining at 0.85 confidence),
  //   - downstream package selector heuristics.
  // Nullable: not every Place returns a priceLevel and legacy rows
  // predate the field. Use `null` to mean "unknown", NOT 0.
  priceLevel           Int?                 @map("price_level")
  sourceQuery          String?              @map("source_query")
  sourceLat            Float?               @map("source_lat")
  sourceLng            Float?               @map("source_lng")
  crawlStatus          CrawlStatus          @default(PENDING) @map("crawl_status")
  analyzeStatus        AnalyzeStatus        @default(PENDING) @map("analyze_status")
  reviewAnalysisStatus ReviewAnalysisStatus @default(PENDING) @map("review_analysis_status")
  // Phase 2.6 — Idempotency guard for the "Apify enrichment populated
  // a websiteUrl, re-run the auditor" trigger. Stores the URL the
  // WEBSITE_AUDITOR last successfully crawled. The Apify Gmaps Deep
  // worker compares this against any newly-discovered website and
  // only enqueues a re-audit when the two differ. Without this the
  // post-Apify hook would re-enqueue an audit on every Apify run
  // even when the site hasn't changed.
  lastAuditedWebsiteUrl String?              @map("last_audited_website_url")

  // Niche pack tagging. `nicheSlug` is the parent NichePack slug (e.g.
  // "fnb", "phone-repair"). `subNicheSlug` is the child slug for hybrid
  // packs (e.g. "fnb-fine-dining"); null for flat niches. `subNicheSource`
  // distinguishes auto-classified leads from rep overrides — the classifier
  // worker only writes when source is null or AUTO. `subNicheConfidence`
  // is the classifier's 0..1 score; the opener writer falls back to the
  // parent (generic F&B) angle when confidence < 0.7 and the source is
  // AUTO, so a low-confidence misclassification doesn't ship a wrong-
  // vertical pitch.
  //
  // `subNicheVersion` increments every time the slug changes (rep
  // override or re-classification). AgentRun rows snapshot this at
  // enqueue time as `inputSubNicheVersion`; workers exit early when
  // the snapshot doesn't match the current version, so a stale audit
  // queued before an override never overwrites the fresh one.
  nicheSlug          String?         @map("niche_slug")
  subNicheSlug       String?         @map("sub_niche_slug")
  subNicheSource     SubNicheSource? @map("sub_niche_source")
  subNicheConfidence Float?          @map("sub_niche_confidence")
  subNicheVersion    Int             @default(0) @map("sub_niche_version")
  // Beta finding §5: hybrid leads (e.g. a hotel-bar that's both
  // "fnb-hotel-fnb" and "fnb-bar-club") need a multi-tag surface so
  // the opener / package selector / mockup picker can match either
  // slug. `subNicheSlugs` is the deduped union of `subNicheSlug` (the
  // primary, classifier-best pick) plus every alternative whose
  // confidence cleared the gate at classification time. Always
  // includes `subNicheSlug` when one exists. `subNicheAlternatives`
  // carries the [{slug, confidence, reason?}] objects so the lead
  // detail "which one is this?" picker can render the runners-up with
  // their evidence intact. Both default to empty so legacy rows that
  // predate this column still resolve cleanly through the existing
  // `subNicheSlug` codepath.
  subNicheSlugs        String[] @default([]) @map("sub_niche_slugs")
  subNicheAlternatives Json     @default("[]") @map("sub_niche_alternatives")
  // Discovery query that surfaced this lead (e.g. "cocktail bar").
  // Used by the rule-based classifier as a strong prior — when the rep
  // searched specifically for "cocktail bar" the resulting lead is
  // almost certainly fnb-bar-club. Distinct from `sourceQuery` which is
  // the raw Google Places query string.
  discoverySourceQuery String?       @map("discovery_source_query")

  // Lead lifecycle flags surfaced by the leads list overhaul. `archivedAt`
  // is a soft-delete sentinel (rep removed the lead from active scope —
  // hidden from list by default but still queryable for restore). The
  // dedicated `discardedAt` separates "I won't pursue this" from "we
  // tracked this and closed it" and powers the kanban discard column.
  // `snoozeUntil` lets a rep hide a lead for N days; the list filter
  // hides leads where snoozeUntil > now(). `assignedToUserId` is the
  // optional owner inside multi-rep workspaces.
  archivedAt        DateTime? @map("archived_at")
  discardedAt       DateTime? @map("discarded_at")
  snoozeUntil       DateTime? @map("snooze_until")
  assignedToUserId  String?   @map("assigned_to_user_id") @db.Uuid

  // Pipeline gate (Service Packages). Defaults to OK for backwards
  // compatibility; flipped to BLOCKED_NEEDS_PACKAGES by `emit("lead_created")`
  // when the workspace has zero ServicePackage rows so the analyst
  // doesn't get to a Gemini call without a price card to pick from.
  // The workspace's first package creation should re-process these.
  pipelineStatus LeadPipelineStatus @default(OK) @map("pipeline_status")

  // SDR workflow fields (Phase 0/1). `lastContactedAt` is the most
  // recent outbound touch (any channel). `nextActionDueAt` is the
  // recommended next-touch timestamp the Today's Queue sorts on —
  // null means "queue position determined by salesConfidence".
  // `sequenceStep` is the rep's progression through the active
  // outreach sequence (0 = no sequence active, N = on step N of N+).
  // `lastDisposition` is the outcome of the most recent CALL_LOGGED
  // activity, surfaced as a quick-glance status chip on the queue
  // row so the SDR sees "VOICEMAIL last Tue" without opening the lead.
  lastContactedAt   DateTime?         @map("last_contacted_at")
  nextActionDueAt   DateTime?         @map("next_action_due_at")
  sequenceStep      Int               @default(0) @map("sequence_step")
  lastDisposition   CallDisposition?  @map("last_disposition")

  // Phase 0/B5 — single rolled-up "Sales Confidence" 0-100 score.
  // Computed by LEAD_INTELLIGENCE_BRIEF as a weighted blend of the
  // audit checklist score, reviewAnalysis.leadScore, and the
  // SalesOpportunity.opportunityScore — written denormalized here
  // so the leads list query can sort/filter on it without joining
  // three tables. Null means the brief hasn't run yet (or input
  // signals were insufficient).
  salesConfidence       Int?    @map("sales_confidence")
  // Bumps every time LEAD_INTELLIGENCE_BRIEF writes a new brief.
  // The lead detail page's "Re-analyze" button forces a new version;
  // older briefs are kept on AgentRun for audit but the UI shows
  // only the latest.
  intelligenceVersion   Int     @default(0) @map("intelligence_version")

  // KVKK / GDPR consent. `dnc` (do-not-contact) is a hard outbound
  // block — send-email/whatsapp APIs refuse to send when true and
  // the UI surfaces a red badge in the lead header. `consentSource`
  // explains lawful basis ("PUBLIC_LISTING" for businesses listed in
  // public directories like Google Maps; "MANUAL_OPT_IN" when the
  // rep records explicit consent; "REFERRED" for warm intros).
  // `consentRecordedAt` timestamps the lawful basis. `optedOutAt`
  // is set when an unsubscribe / "stop calling me" reply lands.
  dnc                  Boolean   @default(false) @map("dnc")
  consentSource        String?   @map("consent_source")
  consentRecordedAt    DateTime? @map("consent_recorded_at")
  optedOutAt           DateTime? @map("opted_out_at")

  // IANA timezone string (e.g. "Europe/Istanbul") inferred at
  // discovery time from formattedAddress / Google Places. Powers
  // "Local time: 14:34" badge so a TR SDR doesn't dial a NYC lead
  // at 4am their time. Phase 2 enrichment.
  timezone             String?   @map("timezone")

  // Phase 2 — optional multi-location grouping. A lead that belongs
  // to a brand with several locations (e.g. FineDine has 5
  // restaurant Places) carries `accountId` so the leads list can
  // roll up under a single brand row. Null = standalone prospect,
  // which remains the default.
  accountId            String?   @map("account_id")

  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedTo       User?             @relation("LeadAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  account          Account?          @relation(fields: [accountId], references: [id], onDelete: SetNull)
  websiteAudit     WebsiteAudit?
  salesOpportunity SalesOpportunity?
  watchlistItem    WatchlistItem?
  googleReviews    GoogleReview[]
  mockups          Mockup[]
  reviewAnalysis   ReviewAnalysis?
  voiceNotes       VoiceNote[]
  agentRuns        AgentRun[]
  websiteMockups   WebsiteMockup[]
  semanticMemory   SemanticMemory[]
  plannerSessions  PlannerSession[]
  activities       LeadActivity[]

  // placeId scoped per workspace so two workspaces can independently track the same business
  @@unique([workspaceId, placeId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, hasWebsite])
  @@index([workspaceId, borough])
  @@index([workspaceId, subNicheSlug])
  @@index([workspaceId, archivedAt])
  @@index([workspaceId, snoozeUntil])
  @@index([workspaceId, assignedToUserId])
  @@index([workspaceId, pipelineStatus])
  // Today's Queue ordering — sorted by nextActionDueAt ASC, scoped
  // to the current rep + active workspace. NULL last so leads
  // without a due-by sort to the bottom.
  @@index([workspaceId, assignedToUserId, nextActionDueAt])
  @@index([workspaceId, salesConfidence])
  @@index([workspaceId, dnc])
  @@index([workspaceId, accountId])
  @@map("leads")
}

// Phase 2 — multi-location account rollup.
//
// FineDine's pilot scenario: a single brand operating 5 restaurant
// locations shows up as 5 separate Lead rows because each location
// has its own Google Place. Without an Account layer the SDR ends
// up cold-pitching the same brand five times. The Account row is a
// soft grouping: leads in the same account share a brand identity
// (name, primary domain, parent contact) and the leads list can
// optionally roll them up to one row.
//
// Account is fully optional — a lead with `accountId = null` is a
// standalone prospect, which is the common case. Manager actions
// (snooze, assign, archive) cascade to all leads in an account when
// triggered from the rollup view.
model Account {
  id           String    @id @default(cuid())
  workspaceId  String    @map("workspace_id")
  // Display name e.g. "FineDine UK" — usually the brand, not a single
  // location name. Reps will see this in the rollup row label.
  name         String
  // Primary apex domain. We use this as the de-dupe signal during
  // discovery: two leads with the same `apexDomain` are auto-grouped
  // into the same Account on a best-effort basis. Manual unmerge
  // is supported by setting `accountId = null` on the lead.
  apexDomain   String?   @map("apex_domain")
  primaryEmail String?   @map("primary_email")
  primaryPhone String?   @map("primary_phone")
  notes        String?
  archivedAt   DateTime? @map("archived_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads     Lead[]

  @@unique([workspaceId, apexDomain])
  @@index([workspaceId, archivedAt])
  @@index([workspaceId, name])
  @@map("accounts")
}

// SDR-first activity timeline. Every outbound or status-change touch
// writes one row here; the lead detail page reads this back as a
// chronological feed and the dashboard aggregates by user + kind +
// day for SDR throughput metrics. Designed to grow into the
// authoritative "what happened on this lead" log so multiple reps
// can pick up where another left off.
model LeadActivity {
  id          String           @id @default(cuid())
  workspaceId String           @map("workspace_id")
  leadId      String           @map("lead_id")
  userId      String?          @map("user_id") @db.Uuid
  kind        LeadActivityKind
  // Optional structured detail per kind:
  // - CALL_LOGGED: { disposition, durationSec?, notes? }
  // - EMAIL_SENT: { subject, bodyPreview, threadId, accountId }
  // - EMAIL_REPLIED: { sentiment, classification, threadId }
  // - WHATSAPP_SENT: { phone, bodyPreview }
  // - NOTE: { body }
  // - STATUS_CHANGED: { from, to }
  // - MEETING_BOOKED: { startsAt, provider, eventId }
  // - DISPOSITION_LOGGED: { disposition, notes? }
  // - SEQUENCE_STEP_FIRED: { sequenceId, step, channel }
  // - SNOOZED: { until }
  // - ASSIGNED: { from, to }
  // - CONSENT_RECORDED: { source }
  payload     Json?
  createdAt   DateTime         @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // M13 - external call id for telephony idempotency. Surfaced as a
  // dedicated column (was previously buried in `payload.externalCallId`)
  // so the @@unique below enforces "one terminal CALL_LOGGED per
  // (workspace, lead, externalCallId)" at the DB layer instead of
  // racing on a JSON-path findFirst pre-check. Nullable because
  // most kinds don't have an external id (NOTE, SEQUENCE_STEP_FIRED,
  // etc.); the unique constraint is enforced for non-null values
  // only via the partial-index pattern Postgres allows on a unique
  // constraint over a nullable column.
  externalCallId String? @map("external_call_id")

  @@index([workspaceId, leadId, createdAt])
  @@index([workspaceId, kind, createdAt])
  @@index([workspaceId, userId, createdAt])
  @@unique([workspaceId, leadId, kind, externalCallId])
  @@map("lead_activities")
}

// Phase 2 — Native multi-touch sequence engine.
//
// A `Sequence` is a workspace-level cadence template (e.g. "Restaurant
// 5-touch"). It is composed of ordered `SequenceStep` rows, each step
// has a channel (EMAIL / WHATSAPP / MANUAL_CALL / WAIT) and a
// `delayHours` offset from the previous step. When a lead is enrolled,
// a `LeadSequenceState` row tracks which step we're on, when the next
// step is due, and whether the cadence has been paused (typically by
// a positive reply from the inbox-reply-attributor).
//
// Execution path: a tick worker scans LeadSequenceState rows whose
// `nextStepAt <= now()` and whose `pausedAt IS NULL`, and enqueues a
// discriminated job into the existing `agent-runs` queue with
// `type="sequence_step"`. We deliberately do NOT spin up a new BullMQ
// queue — see the always-applied workspace rule about not adding
// queues for AI/automation work.
model Sequence {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  description String?
  // ICP / niche tags — used as a hint to the rep ("this sequence is
  // tuned for fnb-restaurant"). Free-form to avoid over-constraining.
  niche       String?
  // Soft-delete: paused sequences keep their state rows but stop
  // ticking. Useful when an admin is editing the cadence and wants
  // a freeze before re-enrolling leads.
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  steps     SequenceStep[]
  states    LeadSequenceState[]

  @@index([workspaceId, archivedAt])
  @@map("sequences")
}

enum SequenceChannel {
  EMAIL
  WHATSAPP
  MANUAL_CALL
  WAIT
}

model SequenceStep {
  id         String          @id @default(cuid())
  sequenceId String          @map("sequence_id")
  position   Int
  channel    SequenceChannel
  // Hours to wait AFTER the previous step completes (or after enroll
  // for position=0). 0 = fire immediately on enroll.
  delayHours Int             @default(0) @map("delay_hours")
  // Channel-specific payload. EMAIL: { subject, bodyTemplate }.
  // WHATSAPP: { bodyTemplate }. MANUAL_CALL: { promptForRep }.
  // WAIT: { reason }. The opener-writer worker can fill in the
  // bodyTemplate for AI-personalised steps; otherwise this is a
  // static rep-authored template with mustache-style {{businessName}}.
  payload    Json?
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  sequence Sequence            @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  states   LeadSequenceState[] @relation("CurrentStep")

  @@unique([sequenceId, position])
  @@index([sequenceId])
  @@map("sequence_steps")
}

enum SequenceState {
  ACTIVE
  PAUSED
  COMPLETED
  EXITED
}

model LeadSequenceState {
  id              String         @id @default(cuid())
  workspaceId     String         @map("workspace_id")
  leadId          String         @map("lead_id")
  sequenceId      String         @map("sequence_id")
  // Pointer to the step we're currently AT (next to fire), not the
  // last completed step. Null = enrollment finished and the lead
  // dropped off the cadence.
  currentStepId   String?        @map("current_step_id")
  state           SequenceState  @default(ACTIVE)
  // Inclusive scheduling window. Tick worker picks a row when
  // `state=ACTIVE` and `nextStepAt <= now()`.
  nextStepAt      DateTime?      @map("next_step_at")
  pausedAt        DateTime?      @map("paused_at")
  // Why was the cadence paused? "REPLY_RECEIVED" stops outbound
  // until the rep manually resumes; "DNC" stops permanently;
  // "MANAGER_PAUSE" is a soft hand-off. Free-form for now.
  pausedReason    String?        @map("paused_reason")
  enrolledAt      DateTime       @default(now()) @map("enrolled_at")
  enrolledByUserId String?       @map("enrolled_by_user_id") @db.Uuid
  completedAt     DateTime?      @map("completed_at")
  // Bumps every time a step fires so we can attribute LeadActivity
  // back to a specific (sequence, step, attempt) tuple.
  stepsFired      Int            @default(0) @map("steps_fired")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  sequence    Sequence      @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  currentStep SequenceStep? @relation("CurrentStep", fields: [currentStepId], references: [id], onDelete: SetNull)

  // One active state per (workspace, lead, sequence). A lead can be
  // re-enrolled after EXITED but only one ACTIVE row exists at a
  // time — the API enforces this.
  @@unique([workspaceId, leadId, sequenceId])
  @@index([workspaceId, state, nextStepAt])
  @@index([workspaceId, leadId])
  @@map("lead_sequence_states")
}

// Saved smart-segment for the leads list. `queryJson` is the serialized
// LeadsFilters object (see src/components/app/leads/useLeadsQuery.ts) so a
// rep can save a filter combo and reload it later. `isShared` opens the
// segment up to every member of the workspace; otherwise only the
// creator sees it. Solo workspaces still benefit — saved segments act as
// favourite filter presets.
model LeadSegment {
  id              String   @id @default(cuid())
  workspaceId     String   @map("workspace_id")
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  name            String
  queryJson       Json     @map("query_json")
  isShared        Boolean  @default(false) @map("is_shared")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("LeadSegmentCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, isShared])
  @@map("lead_segments")
}

// A public, shareable mockup of what the prospect's site COULD look like.
// Used as a "value upfront" hook in cold outreach: the mockup URL gets
// embedded in the first-draft opener so the email lands as a free deliverable
// rather than a pitch.
model Mockup {
  id          String    @id @default(cuid())
  slug        String    @unique
  leadId      String    @map("lead_id")
  workspaceId String    @map("workspace_id")
  htmlContent String    @map("html_content") @db.Text
  templateId  String?   @map("template_id")
  isPublic    Boolean   @default(true) @map("is_public")
  expiresAt   DateTime? @map("expires_at")
  viewCount   Int       @default(0) @map("view_count")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([workspaceId])
  @@map("mockups")
}

model WebsiteAudit {
  id                    String   @id @default(cuid())
  leadId                String   @unique @map("lead_id")
  url                   String
  reachable             Boolean  @default(false)
  // Phase 0/B1 — extra crawl signals so the UI can disambiguate
  // "we did not crawl yet" vs "the page returned 401/403 to our
  // bot but a human can open it" vs "DNS / SSL hard fail". Before
  // this fix the crawler treated ANY non-200 as `reachable=false`
  // and zeroed out every other field, which led to the FineDine
  // SDR seeing "Reachable: No / Title: — / Mobile Friendly: No"
  // for sites that humans could open fine.
  // - crawlAttemptedAt: last time we tried (null = never tried).
  // - crawlError: short error tag (e.g. "TIMEOUT", "DNS_ERROR",
  //   "BOT_BLOCKED_4XX", "PLAYWRIGHT_CRASH"). Null on success.
  // - httpStatus: final HTTP status from the navigation response,
  //   even when 4xx/5xx. null when navigation never produced a
  //   response (timeout / DNS / TLS failure).
  crawlAttemptedAt      DateTime? @map("crawl_attempted_at")
  crawlError            String?   @map("crawl_error")
  httpStatus            Int?      @map("http_status")
  loadTimeMs            Int?     @map("load_time_ms")
  https                 Boolean  @default(false)
  mobileFriendlyGuess   Boolean  @default(false) @map("mobile_friendly_guess")
  title                 String?
  metaDescription       String?  @map("meta_description")
  h1                    String?
  hasContactForm        Boolean  @default(false) @map("has_contact_form")
  hasWhatsappLink       Boolean  @default(false) @map("has_whatsapp_link")
  hasBookingSystem      Boolean  @default(false) @map("has_booking_system")
  bookingProvider       String?  @map("booking_provider")
  hasEcommerce          Boolean  @default(false) @map("has_ecommerce")
  servicesDetected      Json     @default("[]") @map("services_detected")
  navItems              Json     @default("[]") @map("nav_items")
  ctaLinks              Json     @default("[]") @map("cta_links")
  contactEmails         Json     @default("[]") @map("contact_emails")
  // P0.4: per-email verification status. Shape: [{ email, verified, verifiedAt, status }]
  // where status is the raw provider response ("valid"/"invalid"/"catch-all"/"unknown").
  // CSV export filters by verified=true unless user opts in to raw mode.
  contactEmailsVerified Json     @default("[]") @map("contact_emails_verified")
  // P0.5: extended social profile scraping. Shape: { instagram, facebook, linkedin, tiktok, youtube, twitter, whatsapp }
  socialProfiles        Json     @default("{}") @map("social_profiles")
  brokenLinksCount      Int      @default(0) @map("broken_links_count")
  structuredDataPresent Boolean  @default(false) @map("structured_data_present")
  rawFeaturesJson       Json?    @map("raw_features_json")
  createdAt             DateTime @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([bookingProvider])
  @@map("website_audits")
}

model SalesOpportunity {
  id                       String         @id @default(cuid())
  leadId                   String         @unique @map("lead_id")
  opportunityScore         Int            @default(0) @map("opportunity_score")
  reasonCodes              Json           @default("[]") @map("reason_codes")
  whyGoodTarget            String?        @map("why_good_target")
  likelyPainPoints         Json           @default("[]") @map("likely_pain_points")
  bestSalesAngle           String?        @map("best_sales_angle")
  suggestedOffer           SuggestedOffer @default(STARTER) @map("suggested_offer")
  personalizedFirstMessage String?        @map("personalized_first_message")
  expectedPriceBand        String?        @map("expected_price_band")
  // ServicePackage tier the analyst picked for this lead. Free-text id
  // (NOT a FK) so a deleted/renamed package leaves the recommendation
  // intact as a tombstone the UI can render as plain text and the rep
  // can re-trigger to refresh. Resolved at render time against
  // ServicePackage.findMany({ workspaceId }) so cross-tenant access
  // remains scoped.
  recommendedPackageId     String?        @map("recommended_package_id")
  recommendedPackageReason String?        @map("recommended_package_reason")
  status                   OutreachStatus @default(NEW)
  createdAt                DateTime       @default(now()) @map("created_at")
  updatedAt                DateTime       @updatedAt @map("updated_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("sales_opportunities")
}

model WatchlistItem {
  id              String          @id @default(cuid())
  leadId          String          @unique @map("lead_id")
  siteUrl         String?         @map("site_url")
  notes           String?
  websitePlan     String?         @map("website_plan") @db.Text
  pipelineNotes   String?         @map("pipeline_notes") @db.Text
  selectedOffer   SuggestedOffer? @map("selected_offer")
  meetingResult   MeetingResult?  @map("meeting_result")
  // Kanban pipeline stage. Replaces meetingResult as the primary sales-stage
  // signal; meetingResult is kept for backward compat but no longer drives UI.
  pipelineStage   PipelineStage   @default(NEW) @map("pipeline_stage")
  // Within-column sort order for the kanban board. Lower = higher in column.
  stageOrder      Int             @default(0) @map("stage_order")
  // P1.3 calendar sync: next scheduled meeting with this lead (Google Cal / Outlook).
  nextMeetingAt   DateTime?       @map("next_meeting_at")
  meetingProvider String?         @map("meeting_provider")
  meetingEventId  String?         @map("meeting_event_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([pipelineStage, stageOrder])
  @@map("watchlist_items")
}

model GoogleReview {
  id           String   @id @default(cuid())
  leadId       String   @map("lead_id")
  authorName   String   @map("author_name")
  authorPhoto  String?  @map("author_photo")
  rating       Int
  text         String?
  relativeTime String   @map("relative_time")
  publishTime  DateTime @map("publish_time")
  createdAt    DateTime @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("google_reviews")
}

model TeamTodo {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  column      String
  text        String
  done        Boolean  @default(false)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, column])
  @@map("team_todos")
}

// P0.1 - Review Intelligence v1.
// Aggregated KPI analysis derived from up to 50 GoogleReview rows for a lead.
// Mapileads-style weakness/strength bars, sentiment breakdown, lead score.
// Generated by `analyze-reviews` worker via Gemini 2.5 Flash JSON mode.
model ReviewAnalysis {
  id                   String   @id @default(cuid())
  leadId               String   @unique @map("lead_id")
  reviewsAnalyzedCount Int      @default(0) @map("reviews_analyzed_count")
  // [{ label: "wait time", percent: 90 }, ...]
  weaknessKpis         Json     @default("[]") @map("weakness_kpis")
  strengthKpis         Json     @default("[]") @map("strength_kpis")
  // { positive: 0.65, neutral: 0.20, negative: 0.15 }
  sentimentBreakdown   Json     @default("{}") @map("sentiment_breakdown")
  painPhrases          Json     @default("[]") @map("pain_phrases")
  strengthPhrases      Json     @default("[]") @map("strength_phrases")
  // Pattern: "X yıllarca kullandık ama Y, Z'ye geçtik" extracted from positive reviews.
  switchSignals        Json     @default("[]") @map("switch_signals")
  // 0-100 hot prospect score for what your offer fixes (higher = better fit).
  leadScore            Int      @default(0) @map("lead_score")
  // Free-text 1-2 sentence narrative summarizing what reviewers care about.
  summary              String?  @db.Text
  analyzedAt           DateTime @default(now()) @map("analyzed_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("review_analyses")
}

// P0.7 - Voice notes light.
// 30-second voice memo recorded from the lead detail page (saha satışçısı ICP4).
// Transcribed via Whisper / Gemini, attached to the lead, optionally appended to
// WatchlistItem.pipelineNotes for pipeline visibility.
model VoiceNote {
  id          String   @id @default(cuid())
  leadId      String   @map("lead_id")
  workspaceId String   @map("workspace_id")
  audioUrl    String?  @map("audio_url")
  durationSec Int      @default(0) @map("duration_sec")
  transcript  String?  @db.Text
  language    String?
  source      String   @default("web") @map("source")
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([workspaceId])
  @@map("voice_notes")
}

// P1.1 - Direct email send.
// Connected Gmail / Outlook OAuth account used to send openers + mockup links
// from inside the platform. CSV export to Smartlead/Instantly stays as the
// alternative path for users who already live in those senders.
model EmailAccount {
  id                      String        @id @default(cuid())
  workspaceId             String        @map("workspace_id")
  userId                  String        @map("user_id") @db.Uuid
  provider                EmailProvider
  email                   String
  accessToken             String        @map("access_token") @db.Text
  refreshToken            String        @map("refresh_token") @db.Text
  expiresAt               DateTime?     @map("expires_at")
  dailyLimit              Int           @default(500) @map("daily_limit")
  sentToday               Int           @default(0) @map("sent_today")
  resetAt                 DateTime      @default(now()) @map("reset_at")
  // P1.4 reply attribution opt-in. When true, the worker reads inbox replies
  // and updates SalesOpportunity.status accordingly.
  replyAttributionEnabled Boolean       @default(false) @map("reply_attribution_enabled")
  lastInboxSyncAt         DateTime?     @map("last_inbox_sync_at")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([userId])
  @@map("email_accounts")
}

// Stripe webhook idempotency. Stripe retries delivered events; we insert
// the event id on first successful handling and skip replays. No PII; just
// the event id and type for audit.
model StripeEventLog {
  id         String   @id
  type       String
  receivedAt DateTime @default(now()) @map("received_at")

  @@index([receivedAt])
  @@map("stripe_event_log")
}

// P1.2 - AI sales co-pilot chat.
// Workspace-wide chat history. Each message references which leadIds the
// assistant pulled context from, so the user can audit "where did this
// recommendation come from."
model CopilotMessage {
  id          String      @id @default(cuid())
  workspaceId String      @map("workspace_id")
  userId      String      @map("user_id") @db.Uuid
  role        CopilotRole
  content     String      @db.Text
  // [leadId, leadId, ...] - which leads the assistant pulled context from.
  leadIds     Json        @default("[]") @map("lead_ids")
  // Token cost tracking for tier quota enforcement.
  tokensIn    Int         @default(0) @map("tokens_in")
  tokensOut   Int         @default(0) @map("tokens_out")
  createdAt   DateTime    @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("copilot_messages")
}

// AI Workers runtime - one row per agent worker invocation. Phase 1 writes
// rows for Grup B + C workers (Pitch + Deliverable). Grup A workers still
// mutate Lead.crawlStatus / analyzeStatus / reviewAnalysisStatus to avoid a
// breaking migration; they move to AgentRun in Phase 2.
//
// Lifecycle: row created PENDING by API handler, worker picks up, marks
// RUNNING, finishes as SUCCEEDED or FAILED. outputJson holds the worker's
// raw structured output (JSON schema per worker kind). artifactUrl is set
// when the worker produces a shareable public link (e.g. a WebsiteMockup
// slug becomes /m/{slug}). errorMsg captures the failure message for UI.
model AgentRun {
  id               String          @id @default(cuid())
  workspaceId      String          @map("workspace_id")
  leadId           String?         @map("lead_id")
  userId           String?         @map("user_id") @db.Uuid
  workerKind       AgentWorkerKind @map("worker_kind")
  status           AgentRunStatus  @default(PENDING)
  inputsJson       Json            @default("{}") @map("inputs_json")
  outputJson       Json?           @map("output_json")
  artifactUrl      String?         @map("artifact_url")
  costTokens       Int             @default(0) @map("cost_tokens")
  // USD-denominated external cost (primarily Apify actor runs). Gemini
  // usage continues to flow through costTokens; keeping them separate
  // means the UI can split "AI model spend" from "data enrichment spend".
  costUsdCents     Int             @default(0) @map("cost_usd_cents")
  // DAG coordination. When set, this run was scheduled as part of a
  // PlannerSession; parentRunId points at an upstream run whose output
  // we depended on. Both are nullable so legacy single-shot runs stay
  // working.
  parentRunId      String?         @map("parent_run_id")
  plannerSessionId String?         @map("planner_session_id")
  // Deterministic hash of (workspaceId, workerKind, leadId, inputs).
  // When two callers try to enqueue the same work concurrently the
  // second one collides on the unique index and must re-use the
  // existing row instead of creating a duplicate. BullMQ job ids
  // also derive from this so retries cannot land twice.
  // The unique index on (workspace_id, idempotency_key) is created
  // as a partial index (WHERE idempotency_key IS NOT NULL) in
  // prisma/migrations/add_agent_run_idempotency_key.sql so legacy
  // rows with NULL keys do not collide. Prisma cannot express the
  // WHERE clause so we run it out of band after `prisma db push`.
  idempotencyKey   String?         @map("idempotency_key")
  // Snapshot of `Lead.subNicheVersion` at enqueue time. When the
  // worker resolves and finds the lead's current version is higher,
  // it exits with status SUCCEEDED + reason "stale-subniche-version"
  // without writing any lead state. Protects against a worker that
  // was queued before a rep override / re-classification overwriting
  // the fresh result. Null for runs unrelated to a lead or for legacy
  // rows pre-dating the version stamp.
  inputSubNicheVersion Int?         @map("input_sub_niche_version")
  errorMsg         String?         @map("error_msg") @db.Text
  startedAt        DateTime?       @map("started_at")
  finishedAt       DateTime?       @map("finished_at")
  createdAt        DateTime        @default(now()) @map("created_at")

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead           Lead?           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  plannerSession PlannerSession? @relation(fields: [plannerSessionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, workerKind, createdAt])
  @@index([leadId, workerKind])
  @@index([plannerSessionId])
  @@map("agent_runs")
}

// Website Mockup Generator output - a fully rendered landing page for a
// single lead. The current `Mockup` table stores markdown website PLANS
// (strategy docs) with a confusing `htmlContent` field name; `WebsiteMockup`
// is the real landing-page artifact. Served at /m/{slug} (unified route
// prefers WebsiteMockup over legacy Mockup for the same slug keyspace).
//
// Storage: sectionsJson holds the Gemini-produced structured data
// (hero / services / testimonial / cta / about); themeJson holds the
// color + mode config; htmlCache caches the server-rendered HTML string
// so /m/{slug} stays instant-load on cold-email click. Regenerate a
// mockup by nulling htmlCache, the public route re-renders on next hit.
model WebsiteMockup {
  id           String    @id @default(cuid())
  slug         String    @unique
  leadId       String    @map("lead_id")
  workspaceId  String    @map("workspace_id")
  sectionsJson Json      @map("sections_json")
  themeJson    Json      @map("theme_json")
  htmlCache    String?   @map("html_cache") @db.Text
  templateId   String    @default("leadac-hero-v1") @map("template_id")
  isPublic     Boolean   @default(true) @map("is_public")
  expiresAt    DateTime? @map("expires_at")
  viewCount    Int       @default(0) @map("view_count")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([workspaceId])
  @@map("website_mockups")
}

// AI Core - semantic memory substrate. Every worker reads/writes here
// through `src/lib/ai-core/memory.ts`. `embedding` is a pgvector
// vector(768) column populated by Gemini text-embedding-004; an HNSW
// index on `embedding vector_cosine_ops` is created via a raw SQL
// migration (see prisma/migrations/add_ai_core.sql). `metadata` carries
// kind-specific extras (e.g. social platform, SERP query, reply outcome).
model SemanticMemory {
  id          String                      @id @default(cuid())
  workspaceId String                      @map("workspace_id")
  kind        MemoryKind
  leadId      String?                     @map("lead_id")
  // Free-form reference back to the source domain object. `refType` is
  // a string rather than an enum so new kinds (e.g. pointing at
  // `WebsiteMockup`) don't require a migration. Pair it with `refId`.
  refType     String?                     @map("ref_type")
  refId       String?                     @map("ref_id")
  // Niche pack slug this row was learned from. For hybrid niches
  // (parent + 10 children) we tag with the most specific slug — i.e.
  // the lead's `subNicheSlug` ("fnb-bar-club") if present, else its
  // `nicheSlug` ("fnb"). Reads scope by querying the child slug first
  // and falling back to "any child of parent" (LIKE 'fnb-%') when the
  // child has too few hits. Null for niche-agnostic memory like
  // WORKSPACE_OFFER, WORKSPACE_PERSONA, COPILOT_TURN.
  nicheScope  String?                     @map("niche_scope")
  text        String                      @db.Text
  // Nullable so an upsert can create the row first and enqueue an embed
  // job that populates the vector asynchronously.
  embedding   Unsupported("vector(768)")?
  metadata    Json                        @default("{}")
  createdAt   DateTime                    @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([workspaceId, kind])
  @@index([workspaceId, kind, nicheScope])
  @@index([leadId])
  // Composite uniqueness on (workspaceId, refType, refId, nicheScope)
  // so concurrent upserts cannot duplicate the same source object
  // within the same scope, while still permitting the asymmetric
  // dual-write strategy: a positive signal (OPENER_SUCCESS,
  // MOCKUP_SECTION, LEAD_PROFILE) is written twice — once tagged
  // with the child slug ("fnb-bar-club") and once with the parent
  // slug ("fnb") — so a brand-new sub-niche with no hits still gets
  // few-shot fuel from the parent. Negative signals (OPENER_FAILURE)
  // are written child-only so a bar-club failure doesn't poison
  // cafe-bakery retrieval. Postgres treats NULL as distinct, so rows
  // without refType/refId (COPILOT_TURN) are unaffected by this key.
  @@unique([workspaceId, refType, refId, nicheScope])
  @@map("semantic_memory")
}

// AI Core - planner session. One row per orchestration invocation. The
// `plan` JSON is an array of steps `[{ stepId, workerKind, dependsOn[],
// status, inputs?, optional? }]` populated by `src/lib/ai-core/planner.ts`
// and advanced by `src/lib/ai-core/orchestrator.ts`. Every AgentRun
// spawned from a session carries `plannerSessionId` back here so the
// UI can render the DAG as a single entity.
model PlannerSession {
  id          String         @id @default(cuid())
  workspaceId String         @map("workspace_id")
  userId      String?        @map("user_id") @db.Uuid
  leadId      String?        @map("lead_id")
  goal        String         @db.Text
  plan        Json
  status      PlannerStatus  @default(PLANNING)
  triggeredBy PlannerTrigger @map("triggered_by")
  errorMsg    String?        @map("error_msg") @db.Text
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs      AgentRun[]
  Lead      Lead?      @relation(fields: [leadId], references: [id])

  @@index([workspaceId, status])
  @@index([leadId])
  @@map("planner_sessions")
}

// Editable service package tiers shown in Campaigns → Service Packages and
// seeded during onboarding. Each workspace configures its own packages.
// Features is a Postgres text[] column rendered as a checklist in the UI.
model ServicePackage {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  priceLabel  String   @map("price_label")
  features    String[] @map("features")
  isPopular   Boolean  @default(false) @map("is_popular")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Per-workspace name uniqueness so seed scripts and the
  // packages-form UI can upsert by (workspaceId, name) without
  // worrying about duplicates. The pre-existing API route already
  // creates one package per name conceptually; this just enforces
  // it at the DB level.
  @@unique([workspaceId, name])
  @@index([workspaceId, sortOrder])
  @@map("service_packages")
}

// ============================================================================
// Marketing analytics (founder-level, NOT workspace-scoped)
// ----------------------------------------------------------------------------
// First-party tracking for the public marketing surfaces ((marketing) and
// (public) route groups). These tables are intentionally global because
// visitors are anonymous and have no workspace yet. Access is gated through
// `requireAdminEmail()` in src/lib/admin-auth.ts (mirrors the existing
// HEALTH_ADMIN_EMAILS pattern). The multi-tenant `workspaceId` rule does
// NOT apply here.
//
// PII discipline:
// - Raw IP is never written; only sha256(ip) -> ipHash.
// - Property bag rejects form values, emails, names. Stores selectors,
//   visible CTA text, durations, scroll depths.
// - Geo derives from edge headers (x-vercel-ip-country etc.); no IP lookup.
// ============================================================================

// One row per visitor session. A "session" rolls over after 30 minutes of
// idle time on the client (sessionStorage) or when a new visitorId appears.
// `posthogSessionId` is the bridge to PostHog session replay so the admin
// detail view can deep-link "watch the recording".
model MarketingSession {
  id String @id @default(cuid())

  // Long-lived browser fingerprint stored in localStorage. NOT a user id;
  // a single human can have multiple visitorIds (clearing storage, new
  // device). Index helps with "show me everything this visitor has done".
  visitorId String @map("visitor_id")

  startedAt      DateTime  @default(now()) @map("started_at")
  lastActivityAt DateTime  @updatedAt @map("last_activity_at")
  endedAt        DateTime? @map("ended_at")
  durationMs     Int?      @map("duration_ms")

  // Attribution snapshot taken at session start.
  utmSource   String? @map("utm_source")
  utmMedium   String? @map("utm_medium")
  utmCampaign String? @map("utm_campaign")
  utmContent  String? @map("utm_content")
  utmTerm     String? @map("utm_term")
  referrer    String? @db.Text
  landingPath String  @map("landing_path")
  exitPath    String? @map("exit_path")

  // Device.
  userAgent      String? @map("user_agent") @db.Text
  device         String? // "mobile" | "tablet" | "desktop"
  browser        String?
  os             String?
  viewportWidth  Int?    @map("viewport_width")
  viewportHeight Int?    @map("viewport_height")

  // Geo (edge headers only, no IP lookup).
  ipHash  String? @map("ip_hash")
  country String?
  region  String?
  city    String?

  // Engagement summary (denormalized for fast list queries).
  pageCount    Int     @default(0) @map("page_count")
  maxScrollPct Int     @default(0) @map("max_scroll_pct")
  hasEngaged   Boolean @default(false) @map("has_engaged")
  hasConverted Boolean @default(false) @map("has_converted")

  // PostHog cross-link. Set when the client tracker observes
  // posthog.get_session_id() and the ingest endpoint persists it.
  posthogSessionId String? @map("posthog_session_id")

  pageViews MarketingPageView[]
  events    MarketingEvent[]

  @@index([startedAt(sort: Desc)])
  @@index([visitorId])
  @@index([hasConverted, startedAt])
  @@index([utmSource, utmCampaign])
  @@map("marketing_sessions")
}

// One row per page entry. Multiple rows per session (one per navigation).
// `maxScrollPct` and `scrollMilestones` are updated by subsequent batches
// from the same page; we upsert by (sessionId, path, enteredAt).
model MarketingPageView {
  id        String @id @default(cuid())
  sessionId String @map("session_id")

  path      String
  title     String?
  referrer  String? @db.Text
  enteredAt DateTime  @default(now()) @map("entered_at")
  leftAt    DateTime? @map("left_at")
  durationMs Int?     @map("duration_ms")

  maxScrollPct     Int   @default(0) @map("max_scroll_pct")
  // Subset of [25, 50, 75, 100] reached. Stored as int[] so we can
  // build distribution histograms in pure SQL via unnest().
  scrollMilestones Int[] @default([]) @map("scroll_milestones")

  session MarketingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, enteredAt])
  @@index([path, enteredAt])
  @@map("marketing_page_views")
}

// Atomic events. `properties` is a Json bag with shape per `type`:
//   click       -> { selector, text, x, y }
//   cta_click   -> { ctaId, text, location }
//   scroll      -> { pct, path }
//   form_focus  -> { formName, fieldName }
//   form_submit -> { formName, fieldCount, durationMs }
//   error       -> { message, source, lineno, colno }
//   signup      -> { method?: "email" }
//   page_view   -> { title?, referrer? }   (denormalised; primary record on MarketingPageView)
model MarketingEvent {
  id          String   @id @default(cuid())
  sessionId   String   @map("session_id")
  pageViewId  String?  @map("page_view_id")
  ts          DateTime @default(now())
  type        String
  path        String
  properties  Json?

  session MarketingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, ts])
  @@index([type, ts(sort: Desc)])
  @@map("marketing_events")
}
