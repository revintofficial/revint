model WatchlistItem {
  id              String          @id @default(cuid())
  leadId          String          @unique @map("lead_id")
  siteUrl         String?         @map("site_url")
  notes           String?
  websitePlan     String?         @map("website_plan") @db.Text
  pipelineNotes   String?         @map("pipeline_notes") @db.Text
  selectedOffer   SuggestedOffer? @map("selected_offer")
  meetingResult   MeetingResult?  @map("meeting_result")
  // Kanban pipeline stage. Replaces meetingResult as the primary sales-stage
  // signal; meetingResult is kept for backward compat but no longer drives UI.
  pipelineStage   PipelineStage   @default(NEW) @map("pipeline_stage")
  // Within-column sort order for the kanban board. Lower = higher in column.
  stageOrder      Int             @default(0) @map("stage_order")
  // P1.3 calendar sync: next scheduled meeting with this lead (Google Cal / Outlook).
  nextMeetingAt   DateTime?       @map("next_meeting_at")
  meetingProvider String?         @map("meeting_provider")
  meetingEventId  String?         @map("meeting_event_id")

  // SDR Brain v2 — 11-stage canonical deal pipeline. `pipelineStage`
  // (5 buckets) is kept for backward compat with the existing kanban;
  // `dealStage` is the finer-grained 11-stage canon used by MEDDPICC
  // gating and OUTCOME_ATTRIBUTOR (only `WON` and `LOST` are terminal
  // events that flush attribution). The kanban renders 7 visible
  // columns; DISCOVERY/NEGOTIATION/WON/LOST/FOLLOWUP show as modal
  // dispositions on the closing column.
  dealStage      DealStage @default(PROSPECTING) @map("deal_stage")
  dealStageOrder Int       @default(0) @map("deal_stage_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lead          Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  qualification DealQualification?

  @@index([pipelineStage, stageOrder])
  @@index([dealStage, dealStageOrder])
  @@map("watchlist_items")
}

model GoogleReview {
  id           String   @id @default(cuid())
