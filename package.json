{
  "name": "revint",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npx prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "workers": "tsx src/workers/index.ts",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "db:studio": "npx prisma studio",
    "db:multitenant": "tsx prisma/migrations/apply.ts bootstrap_multitenant.sql",
    "db:ai-core": "tsx prisma/migrations/apply.ts add_pgvector_extension.sql && npx prisma db push --skip-generate && tsx prisma/migrations/apply.ts add_ai_core.sql",
    "db:check-pgvector": "tsx scripts/check-pgvector.ts",
    "check:contracts": "tsx scripts/check-contracts.ts",
    "icons:generate": "tsx scripts/generate-pwa-icons.ts",
    "seo:validate": "tsx scripts/seo-validate.ts",
    "postinstall": "npx prisma generate && node -e \"process.env.VERCEL || require('child_process').execSync('npx playwright install chromium --with-deps', {stdio:'inherit'})\"",
    "video:seed": "tsx prisma/scripts/seed-video-demo.ts",
    "video:capture": "tsx scripts/capture/run-all.ts",
    "video:capture:audit": "tsx scripts/capture/scenarios/04-audit-morph.ts",
    "video:capture:discovery": "tsx scripts/capture/scenarios/03-discovery.ts",
    "video:capture:mockup": "tsx scripts/capture/scenarios/05-mockup-flip.ts",
    "video:capture:opener": "tsx scripts/capture/scenarios/06-opener.ts",
    "video:capture:pipeline": "tsx scripts/capture/scenarios/07-pipeline.ts",
    "video:dev": "cd video && npm run dev",
    "video:render": "cd video && npm run render:master"
  },
  "dependencies": {
