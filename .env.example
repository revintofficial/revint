# =====================================================================
# Revint — environment variables
#
# Generated from every `process.env.X` read under src/ (plus Prisma's
# DIRECT_URL). Copy to `.env.local` for `npm run dev`, `.env` for scripts
# and `npm run workers`. Never commit real values.
#
# Where each var is needed:
#   [both]    Vercel web project AND the Railway worker service
#   [web]     Vercel web project only
#   [worker]  Railway worker service only
#
# Startup validation: src/lib/env-check.ts (web warns, workers fail fast
# in production). Keep the REQUIRED lists there in sync with this file.
# =====================================================================

# ---------------------------------------------------------------------
# Core — REQUIRED
# ---------------------------------------------------------------------
# [both] Supabase Postgres, pooled connection (pgbouncer, port 6543).
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# [both] Direct connection (port 5432). Used by Prisma migrations and
# prisma/migrations/apply.ts + scripts/*.
DIRECT_URL=postgresql://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# [both] Redis for BullMQ (web enqueues, workers consume) + rate limiting.
# Must NOT be localhost in production (workers refuse to boot).
REDIS_URL=redis://default:password@host:6379
# [both] Supabase project URL + anon key (auth).
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [both] Service role key: admin user lookup / seed scripts. Server only.
SUPABASE_SERVICE_ROLE_KEY=
# [both] Canonical app URL (links in emails, OAuth redirects, mockup URLs).
NEXT_PUBLIC_APP_URL=https://app.revint.dev
# [web] Canonical marketing site URL (SEO metadata). Falls back to APP_URL.
NEXT_PUBLIC_SITE_URL=https://revint.dev

# ---------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------
# [both] Gemini. Single key, or a rotation pool GEMINI_API_KEY_1..N
# (src/lib/gemini-keys.ts). Workers require at least one.
GEMINI_API_KEY=
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# [worker] Claude head agent (src/lib/ai-core/agent/claude.ts).
# ANTHROPIC_API_KEY_1 is accepted as an alternative name.
ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEY_1=
# [worker] Optional model override for the head agent.
ANTHROPIC_MODEL=
# [worker] Set to 1 to skip the boot-time Gemini health check.
SKIP_GEMINI_HEALTHCHECK=

# ---------------------------------------------------------------------
# Head agent + Truth Layer feature flags (src/lib/feature-flags.ts)
# Values: on|off|true|false|1|0. Allow-lists are comma-separated
# workspace ids and win over the global default.
# ---------------------------------------------------------------------
# [both] Global live switch (leave off; use the allow-list for canaries).
CLAUDE_HEAD_AGENT=off
# [both] Workspaces where the head agent runs LIVE (FineDine Beta id here).
CLAUDE_HEAD_AGENT_WORKSPACES=
# [both] Global shadow switch + shadow allow-list.
CLAUDE_HEAD_AGENT_SHADOW=off
CLAUDE_HEAD_AGENT_SHADOW_WORKSPACES=
# [both] Truth Layer flags; each also accepts <FLAG>_WORKSPACES.
# Defaults: on in development, off in production.
TRUTH_LAYER_DECISION_GATES=
TRUTH_LAYER_LOCALE_GATE=
TRUTH_LAYER_LOCALE_GATE_WORKSPACES=
TRUTH_LAYER_SEVERITY_V2=
TRUTH_LAYER_WEBSITE_VERIFY=
TRUTH_LAYER_BRIEF_V2=
TRUTH_LAYER_AVOIDANCE_VALIDATOR=

# ---------------------------------------------------------------------
# Lead data sources
# ---------------------------------------------------------------------
# [both] Google Places (discovery, geocoding, autocomplete, HubSpot ingest).
GOOGLE_PLACES_API_KEY=
# [worker] Apify (reviews, SERP, social scrapers).
APIFY_TOKEN=
# [both] Shared secret Apify sends back on /api/webhooks/apify.
APIFY_WEBHOOK_SECRET=
# [worker] Email verification.
ZEROBOUNCE_API_KEY=
# [web] Gold price widget (optional).
GOLD_API_KEY=

# ---------------------------------------------------------------------
# Billing — Stripe v22 (no apiVersion pin)
# ---------------------------------------------------------------------
# [web] Billing is disabled when STRIPE_SECRET_KEY is empty.
STRIPE_SECRET_KEY=
# [web] Webhook signing secret for /api/billing/webhook.
STRIPE_WEBHOOK_SECRET=
# [web] Price ids (src/lib/plans.ts). Legacy un-suffixed names are fallbacks.
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_USD=
STRIPE_PRICE_PRO_GBP=
STRIPE_PRICE_PRO_ANNUAL_USD=
STRIPE_PRICE_PRO_ANNUAL_GBP=
STRIPE_PRICE_PRO_TEAM=
STRIPE_PRICE_PRO_TEAM_USD=
STRIPE_PRICE_PRO_TEAM_GBP=
STRIPE_PRICE_PRO_TEAM_ANNUAL_USD=
STRIPE_PRICE_PRO_TEAM_ANNUAL_GBP=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_AGENCY_USD=
STRIPE_PRICE_AGENCY_GBP=
STRIPE_PRICE_AGENCY_ANNUAL_USD=
STRIPE_PRICE_AGENCY_ANNUAL_GBP=

# ---------------------------------------------------------------------
# Email (Resend) + mailbox OAuth
# ---------------------------------------------------------------------
# [both] Transactional email.
RESEND_API_KEY=
EMAIL_FROM="Revint <hello@revint.dev>"
EMAIL_REPLY_TO=
# [both] Dev only: redirect every outbound email to this address.
EMAIL_DEV_REDIRECT=
# [web] Internal notifications for demo requests / waitlist sign-ups.
DEMO_NOTIFY_EMAIL=
WAITLIST_NOTIFY_EMAIL=
# [web] Gmail / Outlook mailbox connect (src/lib/oauth/providers.ts).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URL=

# ---------------------------------------------------------------------
# HubSpot integration
# ---------------------------------------------------------------------
# [both] OAuth app.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URL=
# [web] HMAC secret for the OAuth `state` param.
HUBSPOT_OAUTH_STATE_SECRET=
# [web] Public URLs HubSpot calls (webhook signature base + CRM card).
HUBSPOT_WEBHOOK_URL=
HUBSPOT_CARD_URL=
# [web] Only for the one-off /api/integrations/hubspot/migrate-card route.
HUBSPOT_DEVELOPER_API_KEY=
# [both] 32-byte key (base64/hex) encrypting stored CRM OAuth tokens.
CRM_TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------
# Admin, ops, security
# ---------------------------------------------------------------------
# [web] Bootstrap platform-admin allow-list (comma-separated emails).
ADMIN_DASHBOARD_EMAILS=
# [web] Emails that get the verbose /api/health payload.
HEALTH_ADMIN_EMAILS=
# [web] Bearer secret for cron-style routes (e.g. hubspot reconcile).
CRON_SECRET=
# [web] >=24 chars. Guards /api/admin/pipeline/cancel-all-global.
LEADAC_GLOBAL_PIPELINE_SECRET=
# [web] Dev only: disable the bare-POST global pipeline kill in dev.
LEADAC_DISABLE_GLOBAL_PIPELINE_KILL_DEV=
# [web] Salt for hashing visitor IPs in marketing analytics.
ANALYTICS_IP_SALT=
# [web] Pre-launch Basic-Auth gate on marketing pages (src/proxy.ts). It is ON
# unless SITE_GATE_DISABLED is exactly "true"; the default password is
# "revint-preview", so set a real one or disable the gate for launch.
# /app, /api, /auth, /login, /signup are never gated.
SITE_GATE_PASSWORD=
SITE_GATE_DISABLED=true
# [web] Set to "true" to disable the app./admin. host boundary (src/proxy.ts).
SUBDOMAIN_ROUTING_DISABLED=

# ---------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------
# [both] Sentry error forwarding from src/lib/logger.ts.
SENTRY_DSN=
# [both] Set to 0 to disable the DB app-log sink behind the admin logs screen.
LOG_SINK=

# ---------------------------------------------------------------------
# Runtime tuning
# ---------------------------------------------------------------------
# [both] Override Prisma pg pool size (default depends on IS_WORKER).
PRISMA_POOL_MAX=
# IS_WORKER is set automatically by src/workers/index.ts — do not set it.

# ---------------------------------------------------------------------
# SEO / analytics (web, public)
# ---------------------------------------------------------------------
INDEXNOW_KEY=
INDEXNOW_KEY_LOCATION=
GSC_SITE_URL=
# Full service-account JSON on one line.
GSC_SERVICE_ACCOUNT_JSON=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_PROJECT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_DEMO_BOOKING_URL=

# ---------------------------------------------------------------------
# Set by the platform — do not set manually
# ---------------------------------------------------------------------
# NODE_ENV, NEXT_RUNTIME, VERCEL, VERCEL_URL, RAILWAY_ENVIRONMENT,
# RAILWAY_PROJECT_ID, VITEST
